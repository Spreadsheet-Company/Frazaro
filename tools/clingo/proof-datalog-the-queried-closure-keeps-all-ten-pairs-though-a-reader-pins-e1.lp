% proof-datalog-the-queried-closure-keeps-all-ten-pairs-though-a-reader-pins-e1.lp
% The proof "the queried closure keeps all ten pairs though a reader pins e1"
% in scripts/proofs/datalog.vla, as a clingo program. Only the SET of rows is compared:
% their order and the header row are DATALOG's own.
% Generated by tools/proofs_lp.ps1; do not edit by hand. tools/check_proofs.ps1
% fails when this file no longer matches its proof.
% Run:  clingo proof-datalog-the-queried-closure-keeps-all-ten-pairs-though-a-reader-pins-e1.lp
% Expect:  vla_verdict(agrees)

% --- the program ---
edge(e2,e1).
edge(e3,e2).
edge(e4,e3).
edge(e5,e4).
any(X,Y) :- edge(X,Y).
any(X,Y) :- edge(X,Z), any(Z,Y).
side(W) :- any(W,e1).

% --- the rows the proof expects, in any order ---
vla_want(e2,e1).
vla_want(e3,e2).
vla_want(e3,e1).
vla_want(e4,e3).
vla_want(e4,e2).
vla_want(e4,e1).
vla_want(e5,e4).
vla_want(e5,e3).
vla_want(e5,e2).
vla_want(e5,e1).

% --- the judge: a row clingo derives that the proof does not list is extra,
% a row the proof lists that clingo does not derive is missing ---
vla_extra(X1,X2) :- any(X1,X2), not vla_want(X1,X2).
vla_missing(X1,X2) :- vla_want(X1,X2), not any(X1,X2).
vla_differs :- vla_extra(X1,X2).
vla_differs :- vla_missing(X1,X2).
vla_verdict(agrees) :- not vla_differs.
vla_verdict(differs) :- vla_differs.
#show vla_verdict/1.
#show vla_extra/2.
#show vla_missing/2.
