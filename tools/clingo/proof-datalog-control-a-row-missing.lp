% proof-datalog-control-a-row-missing.lp
% A CONTROL, which the judge must catch: the proof "a closure asked about one person answers its four reachers"
% in scripts/proofs/datalog.vla, with its last expected row, (e5), left out - wrong on purpose.
% A judge never shown to catch a wrong answer proves nothing.
% Generated by tools/proofs_lp.ps1; do not edit by hand. tools/check_proofs.ps1
% fails when this file no longer matches its proof.
% Run:  clingo proof-datalog-control-a-row-missing.lp
% Expect:  vla_verdict(caught)

% --- the program ---
edge(e2,e1).
edge(e3,e2).
edge(e4,e3).
edge(e5,e4).
any(X,Y) :- edge(X,Y).
any(X,Y) :- edge(X,Z), any(Z,Y).
ask(W) :- any(W,e1).

% --- the rows the proof expects, in any order ---
vla_want(e2).
vla_want(e3).
vla_want(e4).

% --- the judge: a row clingo derives that the proof does not list is extra,
% a row the proof lists that clingo does not derive is missing ---
vla_extra(X1) :- ask(X1), not vla_want(X1).
vla_missing(X1) :- vla_want(X1), not ask(X1).
vla_differs :- vla_extra(X1).
vla_differs :- vla_missing(X1).
vla_verdict(caught) :- vla_differs.
vla_verdict(missed) :- not vla_differs.
#show vla_verdict/1.
#show vla_extra/1.
#show vla_missing/1.
