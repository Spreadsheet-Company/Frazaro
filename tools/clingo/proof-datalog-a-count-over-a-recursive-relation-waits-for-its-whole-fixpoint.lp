% proof-datalog-a-count-over-a-recursive-relation-waits-for-its-whole-fixpoint.lp
% The proof "a count over a recursive relation waits for its whole fixpoint"
% in scripts/proofs/datalog.vla, as a clingo program. Only the SET of rows is compared:
% their order and the header row are DATALOG's own.
% Generated by tools/proofs_lp.ps1; do not edit by hand. tools/check_proofs.ps1
% fails when this file no longer matches its proof.
% Run:  clingo proof-datalog-a-count-over-a-recursive-relation-waits-for-its-whole-fixpoint.lp
% Expect:  vla_verdict(agrees)

% --- the program ---
node(a).
node(b).
node(c).
edge(a,b).
edge(b,c).
reachable(X,Y) :- edge(X,Y).
reachable(X,Z) :- edge(X,Y), reachable(Y,Z).
reachcount(X,N) :- node(X), N = #count { X,Y : reachable(X,Y) }.

% --- the rows the proof expects, in any order ---
vla_want(a,2).
vla_want(b,1).
vla_want(c,0).

% --- the judge: a row clingo derives that the proof does not list is extra,
% a row the proof lists that clingo does not derive is missing ---
vla_extra(X1,X2) :- reachcount(X1,X2), not vla_want(X1,X2).
vla_missing(X1,X2) :- vla_want(X1,X2), not reachcount(X1,X2).
vla_differs :- vla_extra(X1,X2).
vla_differs :- vla_missing(X1,X2).
vla_verdict(agrees) :- not vla_differs.
vla_verdict(differs) :- vla_differs.
#show vla_verdict/1.
#show vla_extra/2.
#show vla_missing/2.
