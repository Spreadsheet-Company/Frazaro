% proof-datalog-count-answers-one-row-per-person-the-one-with-no-sale-a-real-0.lp
% The proof "count answers one row per person, the one with no sale a real 0"
% in scripts/proofs/datalog.vla, as a clingo program. Only the SET of rows is compared:
% their order and the header row are DATALOG's own.
% Generated by tools/proofs_lp.ps1; do not edit by hand. tools/check_proofs.ps1
% fails when this file no longer matches its proof.
% Run:  clingo proof-datalog-count-answers-one-row-per-person-the-one-with-no-sale-a-real-0.lp
% Expect:  vla_verdict(agrees)

% --- the program ---
person(alice).
person(bob).
person(carol).
sale(alice,widget).
sale(alice,gadget).
sale(bob,widget).
salescount(X,N) :- person(X), N = #count { X,Y : sale(X,Y) }.

% --- the rows the proof expects, in any order ---
vla_want(alice,2).
vla_want(bob,1).
vla_want(carol,0).

% --- the judge: a row clingo derives that the proof does not list is extra,
% a row the proof lists that clingo does not derive is missing ---
vla_extra(X1,X2) :- salescount(X1,X2), not vla_want(X1,X2).
vla_missing(X1,X2) :- vla_want(X1,X2), not salescount(X1,X2).
vla_differs :- vla_extra(X1,X2).
vla_differs :- vla_missing(X1,X2).
vla_verdict(agrees) :- not vla_differs.
vla_verdict(differs) :- vla_differs.
#show vla_verdict/1.
#show vla_extra/2.
#show vla_missing/2.
