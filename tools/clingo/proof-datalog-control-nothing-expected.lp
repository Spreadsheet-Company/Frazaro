% proof-datalog-control-nothing-expected.lp
% A CONTROL, which the judge must catch: the proof "a closure asked about one person answers its four reachers"
% in scripts/proofs/datalog.vla, with no row expected at all - wrong on purpose.
% A judge never shown to catch a wrong answer proves nothing.
% Generated by tools/proofs_lp.ps1; do not edit by hand. tools/check_proofs.ps1
% fails when this file no longer matches its proof.
% Run:  clingo proof-datalog-control-nothing-expected.lp
% Expect:  vla_verdict(caught)

% --- the program ---
edge(e2,e1).
edge(e3,e2).
edge(e4,e3).
edge(e5,e4).
any(X,Y) :- edge(X,Y).
any(X,Y) :- edge(X,Z), any(Z,Y).
ask(W) :- any(W,e1).

% --- the rows the proof expects: none ---

% --- the judge: the proof expects no row, so any row clingo derives is extra ---
vla_extra(X1) :- ask(X1).
vla_differs :- vla_extra(X1).
vla_verdict(caught) :- vla_differs.
vla_verdict(missed) :- not vla_differs.
#show vla_verdict/1.
#show vla_extra/1.
