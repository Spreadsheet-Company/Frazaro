% optimize-network-connect - OPTIMIZE.0.1's corpus (scripts/pareto_logic.txt section 17).
% Generated by tools/optimize01_lp.ps1; do not edit by hand. Compare only what the key states.
% Run:  clingo optimize-network-connect.lp 0 --opt-mode=ignore   expect Models : 14
% Run:  clingo optimize-network-connect.lp 0 --opt-mode=optN     expect Optimization : 10 and no Optimal line (one optimal world)

office(hq;north;south;west).
link(hq,north,3). link(hq,south,4). link(north,south,2). link(north,west,5). link(south,west,6).
% each link is switched on, or not
{ on(A,B) : link(A,B,_) }.
joined(A,B) :- on(A,B).
joined(B,A) :- on(A,B).
% an office is reachable if it is HQ, or a link that is on joins it to one
% that is reachable - the recursion through the choices itself
reach(hq).
reach(B) :- reach(A), joined(A,B).
% every office is reachable
:- office(O), not reach(O).
% the lowest total cost of the links that are on
#minimize { C,A,B : on(A,B), link(A,B,C) }.
#show on/2.