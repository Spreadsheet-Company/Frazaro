% proof-datalog-a-headless-program-that-matches-nothing-is-the-blank-cell-not-a-crash.lp
% The proof "a headless program that matches nothing is the blank cell, not a crash"
% in scripts/proofs/datalog.vla, as a clingo program. Only the SET of rows is compared:
% their order and the header row are DATALOG's own.
% Generated by tools/proofs_lp.ps1; do not edit by hand. tools/check_proofs.ps1
% fails when this file no longer matches its proof.
% Run:  clingo proof-datalog-a-headless-program-that-matches-nothing-is-the-blank-cell-not-a-crash.lp
% Expect:  vla_verdict(agrees)

% --- the program ---
thing(a).
nothing_here(X) :- thing(X), thing(none).

% --- the rows the proof expects: none ---

% --- the judge: the proof expects no row, so any row clingo derives is extra ---
vla_extra(X1) :- nothing_here(X1).
vla_differs :- vla_extra(X1).
vla_verdict(agrees) :- not vla_differs.
vla_verdict(differs) :- vla_differs.
#show vla_verdict/1.
#show vla_extra/1.
