% proof-datalog-a-closure-over-a-three-link-chain-answers-all-six-pairs.lp
% The proof "a closure over a three-link chain answers all six pairs"
% in scripts/proofs/datalog.vla, as a clingo program. Only the SET of rows is compared:
% their order and the header row are DATALOG's own.
% Generated by tools/proofs_lp.ps1; do not edit by hand. tools/check_proofs.ps1
% fails when this file no longer matches its proof.
% Run:  clingo proof-datalog-a-closure-over-a-three-link-chain-answers-all-six-pairs.lp
% Expect:  vla_verdict(agrees)

% --- the program ---
reports_to(alice,bob).
reports_to(bob,carol).
reports_to(carol,dave).
indirect_report(X,Y) :- reports_to(X,Y).
indirect_report(X,Y) :- reports_to(X,Z), indirect_report(Z,Y).

% --- the rows the proof expects, in any order ---
vla_want(alice,bob).
vla_want(bob,carol).
vla_want(carol,dave).
vla_want(alice,carol).
vla_want(bob,dave).
vla_want(alice,dave).

% --- the judge: a row clingo derives that the proof does not list is extra,
% a row the proof lists that clingo does not derive is missing ---
vla_extra(X1,X2) :- indirect_report(X1,X2), not vla_want(X1,X2).
vla_missing(X1,X2) :- vla_want(X1,X2), not indirect_report(X1,X2).
vla_differs :- vla_extra(X1,X2).
vla_differs :- vla_missing(X1,X2).
vla_verdict(agrees) :- not vla_differs.
vla_verdict(differs) :- vla_differs.
#show vla_verdict/1.
#show vla_extra/2.
#show vla_missing/2.
