(format 21 none general nowrap (border (left slant-dash-dot) (right slant-dash-dot) (top slant-dash-dot) (bottom slant-dash-dot)))
(format 22 none "\"1\"" nowrap (font bold 22) (align center middle) (border (left medium) (top medium "6B4FC8")))
(format 23 none "\"1\"" nowrap (font bold 22 "1D1D1B") (align right))
(format 24 "FFD5D5" general nowrap (font not-bold "800020") (align center middle) (border (left medium) (top none)))
(format 25 "A080E0" general nowrap (font bold "1D1D1B") (align right))
(format 26 none general nowrap (font bold italic 9.5 "FFFFFF") (align left top))
(format 27 none general nowrap (font bold italic 9.5 "FFFFFF") (align general bottom))
