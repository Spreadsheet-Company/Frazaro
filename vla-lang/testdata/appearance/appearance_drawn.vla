(sheet "Look" visible)
(sheet "Look.last" hidden)
(window "Look" "A1:N6")
(extent "Look" "A1:N6")
(gridlines "Look" off)
(row "Look" 1 30 shown)
(format 0 none general nowrap)
(format 1 none general wrap (align center middle) (border (left medium) (top medium "6B4FC8")))
(format 8 none general nowrap (border (left none) (right none) (top none) (bottom none)))
(format 9 none general nowrap (border (left thin) (right thin) (top thin) (bottom thin)))
(format 10 none general nowrap (border (left medium) (right medium) (top medium) (bottom medium)))
(format 11 none general nowrap (border (left thick) (right thick) (top thick) (bottom thick)))
(format 12 none general nowrap (border (left double) (right double) (top double) (bottom double)))
(format 13 none general nowrap (border (left hair) (right hair) (top hair) (bottom hair)))
(format 14 none general nowrap (border (left dotted) (right dotted) (top dotted) (bottom dotted)))
(format 15 none general nowrap (border (left dashed) (right dashed) (top dashed) (bottom dashed)))
(format 16 none general nowrap (border (left dash-dot) (right dash-dot) (top dash-dot) (bottom dash-dot)))
(format 17 none general nowrap (border (left dash-dot-dot) (right dash-dot-dot) (top dash-dot-dot) (bottom dash-dot-dot)))
(format 18 none general nowrap (border (left medium-dashed) (right medium-dashed) (top medium-dashed) (bottom medium-dashed)))
