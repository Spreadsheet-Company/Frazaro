(sheet "Partial" visible)
(sheet "Partial.last" hidden)
(window "Partial" "A1:H3")
(extent "Partial" "A1:H3")
(gridlines "Partial" off)
(format 0 none general nowrap)
(format 1 "E8E0F7" "0.00" wrap (font bold "1D1D1B") (align right) (border (left medium)))
