(format 5 (wrap nowrap))
(format 6 (fill none) (font not-bold))
(format 7 "6B4FC8" "0.000" wrap)
(format 8 (border (left none) (top thin "6B4FC8")))
(format 9 (number general))
(look "Partial" 1 2)
