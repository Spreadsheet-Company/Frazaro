(sheet "Rules" visible)
(sheet "Rules.last" hidden)
(window "Rules" "A1:F4")
(extent "Rules" "A1:F4")
(gridlines "Rules" off)
(format 0 none general nowrap)
(format 1 "E8E0F7" "0.00" wrap (font bold "1D1D1B") (align right) (border (left medium)))
(format 2 (fill "FFE699"))
(format 3 (font "800020"))
(format 4 (number "0"))
(format 5 (fill none) (font not-bold))
(format 6 (border (left none) (top thin "6B4FC8")))
(format 7 (fill "9DC3E6") (font italic))
(look "Rules" 3 7)
(conditional "Rules" 1 "A1:F1" (cell greater "=4") 2)
(conditional "Rules" 2 "A1:C2" "=A1=2" 3)
(conditional "Rules" 3 "D1:D2" (cell between "=3" "=5") 4 stop)
(conditional "Rules" 4 "D1:F2" "=TRUE" 5)
(conditional "Rules" 5 "A3:C3" "=$A$2=1" 6)
(conditional "Rules" 6 "A4" "=FALSE" 2)
(conditional "Rules" 7 "E3" "=TRUE" none stop)
(conditional "Rules" 8 "E3" "=TRUE" 2)
(cell "Rules" "A1" 1)
(text "Rules" "A1" "1.00")
(style "Rules" "A1" 1)
(cell "Rules" "B1" 2)
(text "Rules" "B1" "2.00")
(style "Rules" "B1" 1)
(lit "Rules" "B1" 2)
(cell "Rules" "C1" 3)
(text "Rules" "C1" "3.00")
(style "Rules" "C1" 1)
(cell "Rules" "D1" 4)
(text "Rules" "D1" "4")
(style "Rules" "D1" 1)
(lit "Rules" "D1" 3)
(cell "Rules" "E1" 5)
(text "Rules" "E1" "5.00")
(style "Rules" "E1" 1)
(lit "Rules" "E1" 1 4)
(cell "Rules" "F1" 6)
(text "Rules" "F1" "6.00")
(style "Rules" "F1" 1)
(lit "Rules" "F1" 1 4)
(cell "Rules" "A2" 1)
(cell "Rules" "B2" 2)
(lit "Rules" "B2" 2)
(cell "Rules" "C2" 3)
(cell "Rules" "D2" 4)
(text "Rules" "D2" "4")
(lit "Rules" "D2" 3)
(cell "Rules" "E2" 5)
(lit "Rules" "E2" 4)
(cell "Rules" "F2" 6)
(lit "Rules" "F2" 4)
(lit "Rules" "A3" 5)
(lit "Rules" "B3" 5)
(lit "Rules" "C3" 5)
(lit "Rules" "E3" 7)
(cell "Rules" "F4" "the corner")
