(message vla-each-name-reserved 5 "VLA" "{op} '{word}': '{word}' is the {desc} and cannot be a name {op} binds")
(message vla-each-name-bound 5 "VLA" "{op}: '{word}' is already a name in this template - give the name {op} binds a word of its own")
(message vla-each-list-a-call 5 "VLA" "{op}: the list to walk is a call of the macro '{head}', which does not expand where a list is walked - give the list itself, quoted or as a parameter")
(message vla-expand-expected-list 5 "VLA" "{op}: expected a list, got '{value}'")
(message vla-assoc-expand-entry 5 "VLA" "assoc-expand: an entry is a list with a head, got '{value}'")
(message vla-define-shape 5 "VLA" "define: write (define name form), a name and the one form it stands for - got {form}")
(message vla-define-name-reference 5 "VLA" "define '{word}': '{word}' reads as {what}, and a define gives a reference a word of its own, such as stop")
(message vla-define-name-reserved 5 "VLA" "define '{word}': '{word}' is {desc}, and a define binds a word of the source's own")
(message vla-define-name-taken 5 "VLA" "define '{word}': '{word}' is {what} in this source - a word names one thing")
(message vla-define-not-a-statement 5 "VLA" "define '{word}': a define stands as a form of the source, or as a statement of a begin that stands as one, and never inside another form or a formula")
(message vla-define-used-in-its-form 5 "VLA" "'{word}' is used in the form of the source that defines it, where it is not yet a name - a define binds the forms after its own")
(message vla-define-cycle 5 "VLA" "define '{word}': the words {ring} stand for one another in a ring - a define names a form that does not come back to it")
(message vla-reference-no-sheet 5 "VLA" "{op}: '{value}' names no sheet, and a formula does not know the sheet it will stand on - write the reference with its sheet, such as Input!B5")
(message vla-reference-expected 5 "VLA" "{op}: expected one reference on a sheet, such as Input!B5 or (ref \"Q1 Data\" \"A1\"), got '{value}', {what}")
(message vla-formula-last-twin 5 "VLA" "last: '{value}' is a twin already, and a twin has none - (last X) takes the reference X itself")
(message vla-version-malformed 5 "VLA" "'{value}' is not a version this build can compare. A version is three whole numbers separated by dots, like 0.5.1 - MAJOR.MINOR.PATCH (SD-14). A suffix such as '-beta' is not read here. Fix the version text: a version that cannot be read is never treated as satisfied.")
(message interp-console-no-result 5 "VLA-Interpreter" "'{name}' holds one of the CLI's last three results - * the newest, ** the one before it, *** the one before that - and there is no such result yet. Only a command that works something out, like (+ 2 3), leaves one behind.")
(message grid-handle-unknown 9 "VLA-Grid" "No grid is loaded under the handle {handle}; a handle is the number a load answered, and it ends with the unload.")
(message grid-handle-limit 5 "VLA-Grid" "{limit} grids are loaded already, the most one module holds at once; unload one before loading another.")
(message grid-row-unknown 5 "VLA-Grid" "A ({head} ...) row is not one taken here; the rows taken here are {kinds}.")
(message grid-row-malformed 5 "VLA-Grid" "The row {row} is not in its shape, {shape}. In a shape, <value> is a number, a text in quotes, true, false or an error such as (error \"#N/A\").")
(message grid-format-code 5 "VLA-Grid" "The format code {code} holds {what}, which this version does not draw; {fix}.")
(message grid-format-property 5 "VLA-Grid" "The format {index}'s {group} holds {what}, which a format does not take; {fix}.")
(message grid-cell-written-twice 5 "VLA-Grid" "{what} was already written by line {first}; a grid's rows say one thing about each cell and each setting, so write it once.")
(message grid-cell-unwritten 5 "VLA-Grid" "The row {row} names {cell}, which no row before it wrote; a {kind} row follows the row that writes its cell.")
(message grid-sheet-name-invalid 5 "VLA-Grid" "A grid cannot hold a sheet named {name}. A sheet's name is 1 to 26 characters, so that the name of its twin, the previous frame, fits Excel's 31; it holds none of \\ / ? * [ ] : and no apostrophe at either end; and a name ending in .last is a twin's own.")
(message grid-sheet-unknown 9 "VLA-Grid" "A write cannot go into {target}: the grid holds no sheet named {name}; it holds {sheets}. A write changes the cells of the sheets a grid holds and makes no sheet.")
(message grid-write-last 5 "VLA-Grid" "{target} is a cell of {sheet}, the previous frame, which is read-only: write {source}, and the end of the next step copies it there.")
(message grid-write-during-step 5 "VLA-Grid" "Frame {frame} is being computed, {evaluated} of {of} cells; a write waits until the step that finishes it.")
(message grid-write-derived 5 "VLA-Grid" "A derived write cannot go into {target}: {cell} holds a formula, and a derived write lands only in a value cell, since the grid's own writes carry values and never replace a formula.")
(message grid-too-many-cells 5 "VLA-Grid" "Writing {target} would bring the grid to {cells} cells, past the {limit} one grid holds beside its twins.")
(message calc-cycle 5 "VLA-Calc" "The formulas in {cells} read one another in a circle, so none of them can be computed first. Break the circle: one of them must read a value, not a formula that reads it back.")
(message calc-function-not-computed 5 "VLA-Calc" "The formula in {cell} calls {function}, which this version does not compute.")
(message calc-construct-not-read 5 "VLA-Calc" "The formula in {cell} reaches {construct}, which this version does not read, so the formula cannot be computed.")
(message calc-formula-too-deep 5 "VLA-Calc" "The formula in {cell} nests more than {limit} levels deep, more than Excel itself allows, so the formula cannot be computed.")
(message calc-formula-too-long 5 "VLA-Calc" "The formula in {cell} is longer than {limit} characters, more than Excel itself allows, so the formula cannot be computed.")
(message view-sheet-unknown 9 "VLA-View" "The grid holds no sheet named {name}; it holds {sheets}.")
(message view-window-not-a-range 5 "VLA-View" "{text} is not a window of a sheet. Write two corners of a rectangle, A1:F20, or one cell, B2; a whole column or row is not a window.")
(message view-projection-unknown 5 "VLA-View" "{name} is not a projection of the grid; the projections are grid, the rows of a window, values, those rows without the formulas' texts, changes, the values' rows of the cells the last frame changed, fills, the rows with each fill's formula once over each of its rectangles, and plane, a byte a cell.")
(message view-window-too-large 5 "VLA-View" "The window {window} holds {cells} cells, past the {limit} one plane holds; view it in parts.")
