(sub vla-report-error ()
  (vlashowerror (& "Something went wrong at step " vla-step ":" vbcrlf vbcrlf
                   (vla-step-text vla-step) vbcrlf vbcrlf
                   "Excel says: " err.description)))

(function vla-step-text ((byval n Long)) String
  (select n
    (case (1) (return "Work on sheet Output. [line 18]"))
    (case (2) (return "Turn off screen updating. [line 20]"))
    (case (3) (return "Create a number called total. [line 21]"))
