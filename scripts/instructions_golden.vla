(const hot-pink "#FF69B4")

(dim vla-problem String)

(dim vla-step Long)

(sub stamp ((optional row-number Variant 1) (optional value Variant "ok"))
  (on-error goto vla-fail)
    (set! vla-step 52)
    (if (vlatraceon) (then (vlatracestep 52 (vla-step-text 52))))
    (raw "' ---- instructions.txt:87 To stamp, with row-number of 1 and value of \"ok\": ----")
    (at-line 90
    (set! (cells row-number "f") value))
  (exit-sub)
  (label vla-fail)
  (vla-report-error))

(function tax ((amount Variant))
  (on-error goto vla-fail)
    (set! vla-step 102)
    (if (vlatraceon) (then (vlatracestep 102 (vla-step-text 102))))
    (raw "' ---- instructions.txt:184 To tax of amount: ----")
    (at-line 187
    (return (* amount 0.08)))
  (exit-function)
  (label vla-fail)
  (vla-report-error))

(sub tidy-up ()
  (on-error goto vla-fail)
    (set! vla-step 109)
    (if (vlatraceon) (then (vlatracestep 109 (vla-step-text 109))))
    (raw "' ---- instructions.txt:198 To tidy-up: ----")
    (at-line 199
    (fit-column "a"))
    (set! vla-step 110)
    (if (vlatraceon) (then (vlatracestep 110 (vla-step-text 110))))
    (at-line 200
    (fit-column "b"))
    (set! vla-step 111)
    (if (vlatraceon) (then (vlatracestep 111 (vla-step-text 111))))
    (at-line 201
    (set-font-color (range "a1") (vlacolor hot-pink)))
  (exit-sub)
  (label vla-fail)
  (vla-report-error))

(function commission ((optional sale Variant 1000) (optional rate Variant (/ 5 100)))
  (on-error goto vla-fail)
    (set! vla-step 112)
    (if (vlatraceon) (then (vlatracestep 112 (vla-step-text 112))))
    (raw "' ---- instructions.txt:203 To get commission using sale of 1000 and rate of 5%: ----")
    (at-line 206
    (return (* sale rate)))
  (exit-function)
  (label vla-fail)
  (vla-report-error))

(function vat-rate ()
  (on-error goto vla-fail)
    (set! vla-step 122)
    (if (vlatraceon) (then (vlatracestep 122 (vla-step-text 122))))
    (raw "' ---- instructions.txt:227 To get vat-rate: ----")
    (at-line 230
    (return (/ 20 100)))
  (exit-function)
  (label vla-fail)
  (vla-report-error))

