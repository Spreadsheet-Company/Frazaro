; ---- carried by phrasebooks (L4) ----
(defmacro (set-formula r f) "write a formula string into a range" (set! (. r formula) f))
(defmacro (make-table r n) "create an Excel Table from a range and name it" (set! (. (. activesheet.listobjects add :sourcetype xlsrcrange :source r :xllistobjecthasheaders xlyes) name) n))
(defmacro (table-property-family name property doc pattern call testsentence testcall value & extras) "generate a table-name/value-setting macro, its english-vla rule, and its test-success proof" (begin (defmacro (name n extras) doc (set! (. (activesheet.listobjects n) property) value)) (english-vla pattern call) (test-success testsentence testcall)))
(defmacro (table-style n s) "set an Excel Table's style" (set! (. (activesheet.listobjects n) tablestyle) s))
(defmacro (table-totals-on n) "show an Excel Table's total row" (set! (. (activesheet.listobjects n) showtotals) true))
(defmacro (table-totals-off n) "hide an Excel Table's total row" (set! (. (activesheet.listobjects n) showtotals) false))
(defmacro (table-to-range n) "convert an Excel Table back into a plain range" (. (activesheet.listobjects n) unlist))
(defmacro (table-add-row n) "append a blank row to an Excel Table" (. (. (activesheet.listobjects n) listrows) add))
(defmacro (table-delete-row n r) "delete a row from an Excel Table by its own row number" (. (. (activesheet.listobjects n) listrows r) delete))
(defmacro (table-column v n c) "bind a variable to one column's data (header excluded) in an Excel Table" (obj-set! v (. (. (activesheet.listobjects n) listcolumns c) databodyrange)))
(defmacro (tablespec-row name doc body pattern call testsentence testcall) "emit one single-parameter defmacro/english-vla/test-success triple - table-property-family's own arity, BODY supplied whole instead of derived from a property/value pair" (begin (defmacro (name n) doc body) (english-vla pattern call) (test-success testsentence testcall)))
(defmacro (tablespec spec) "walk a quoted list of (name doc body pattern call testsentence testcall) rows, calling tablespec-row once per row - see this file's own TABLESPEC comment above for the depth ceiling this inherits" (quote-if (null? spec) (begin) (begin (tablespec-row (car (car spec)) (cadr (car spec)) (car (cddr (car spec))) (cadr (cddr (car spec))) (caddr (cddr (car spec))) (cadr (cddr (cddr (car spec)))) (caddr (cddr (cddr (car spec))))) (tablespec (cdr spec)))))
(defmacro (pivot-create r b n) "create a pivot table from a range at a destination cell" (vlapivotcreate r b n))
(defmacro (pivot-rows n f) "add field names to a pivot table's row area" (vlapivotsetorientation n f "row"))
(defmacro (pivot-columns n f) "add field names to a pivot table's column area" (vlapivotsetorientation n f "column"))
(defmacro (pivot-filters n f) "add field names to a pivot table's filter (page) area" (vlapivotsetorientation n f "filter"))
(defmacro (pivot-remove-field n f) "remove field names from a pivot table's layout entirely" (vlapivotsetorientation n f "hidden"))
(defmacro (pivot-full r destcell n rowfields colfields valfields) "the composite pivot sentence - create, then set rows/columns, then add value fields (sum-only)" (begin (pivot-create r destcell n) (pivot-rows n rowfields) (pivot-columns n colfields) (vlapivotaddvalues n valfields "sum")))
(defmacro (pivot-values-sum n f) "add field names to a pivot table's values area, summed" (vlapivotaddvalues n f "sum"))
(defmacro (pivot-values-count n f) "add field names to a pivot table's values area, counted" (vlapivotaddvalues n f "count"))
(defmacro (pivot-values-average n f) "add field names to a pivot table's values area, averaged" (vlapivotaddvalues n f "average"))
(defmacro (pivot-refresh n) "refresh one pivot table from its source data" (vlapivotrefresh n))
(defmacro (pivot-refresh-all) "refresh every pivot table in the workbook, and nothing else" (vlapivotrefreshall))
(defmacro (pivot-delete n) "delete a pivot table by name" (vlapivotdelete n))
(defmacro (pivot-collapse n f) "collapse field names in a pivot table, hiding their detail" (vlapivotsetshowdetail n f false))
(defmacro (pivot-expand n f) "expand field names in a pivot table, showing their detail" (vlapivotsetshowdetail n f true))
(defmacro (pivot-layout-compact n) "show a pivot table's row fields in Excel's default compact form" (vlapivotsetrowlayout n "compact"))
(defmacro (pivot-layout-tabular n) "show a pivot table's row fields in tabular form (one column per field)" (vlapivotsetrowlayout n "tabular"))
(defmacro (pivot-layout-outline n) "show a pivot table's row fields in outline form" (vlapivotsetrowlayout n "outline"))
(defmacro (pivot-subtotals-hide n f) "hide subtotals for field names in a pivot table" (vlapivotsetsubtotals n f false))
(defmacro (pivot-subtotals-show n f) "show (restore automatic) subtotals for field names in a pivot table" (vlapivotsetsubtotals n f true))
(defmacro (pivot-blank-line-add n f) "insert a blank row after each item of field names in a pivot table" (vlapivotsetblankline n f true))
(defmacro (pivot-blank-line-remove n f) "remove the blank row after each item of field names in a pivot table" (vlapivotsetblankline n f false))
(defmacro (pivot-rename n m) "rename a pivot table" (vlapivotrename n m))
(defmacro (pivot-clear n) "clear a pivot table back to a blank layout, keeping the table itself" (vlapivotclear n))
(defmacro (pivot-source n r) "point a pivot table at a new source range and refresh it" (vlapivotchangesource n r))
(defmacro (pivot-sort-ascending n f) "sort a pivot field's items alphabetically ascending, by its own labels" (vlapivotsort n f "ascending" ""))
(defmacro (pivot-sort-descending n f) "sort a pivot field's items alphabetically descending, by its own labels" (vlapivotsort n f "descending" ""))
(defmacro (pivot-sort-by-value-ascending n f v) "sort a pivot field's items ascending by a value field's numbers" (vlapivotsort n f "ascending" v))
(defmacro (pivot-sort-by-value-descending n f v) "sort a pivot field's items descending by a value field's numbers" (vlapivotsort n f "descending" v))
(defmacro (unhide-all-rows-columns) "show every hidden row and column on the active sheet" (begin (set! (. cells entirerow.hidden) false) (set! (. cells entirecolumn.hidden) false)))
(defmacro (fit-row n) "autofit a row's height to its contents" (. (rows n) autofit))
(defmacro (group-rows a b) "group a span of rows so they can be collapsed" (. (rows (& a ":" b)) group))
(defmacro (ungroup-rows a b) "ungroup a previously-grouped span of rows" (. (rows (& a ":" b)) ungroup))
(defmacro (insert-n-rows-at r n) "insert several blank rows starting at a row number, pushing existing rows down" (. (. (rows r) resize :rowsize n) insert))
(defmacro (delete-rows-range a b) "delete a contiguous span of whole rows" (. (rows (& a ":" b)) delete))
(defmacro (move-column c d) "move a whole column to sit before another column, keeping its formatting" (vlamovecolumn c d))
(defmacro (freeze-first-rows n) "freeze the given number of rows at the top of the active window" (vlafreezepanes n))
(defmacro (copy-formats-only a b) "copy only the formatting from one range onto another, leaving values and formulas untouched" (begin (. a copy) (. b pastespecial :paste xlpasteformats) (set! application.cutcopymode false)))
(defmacro (copy-formulas-only a b) "copy only the formulas from one range into another" (begin (. a copy) (. b pastespecial :paste xlpasteformulas) (set! application.cutcopymode false)))
(defmacro (copy-widths-only a b) "copy only the column widths from one range onto another" (begin (. a copy) (. b pastespecial :paste xlpastecolumnwidths) (set! application.cutcopymode false)))
(defmacro (paste-transposed a b) "copy a range into another location with rows and columns swapped" (begin (. a copy) (. b pastespecial :transpose true) (set! application.cutcopymode false)))
(defmacro (cut-range a b) "move a range's cells to another location, leaving the source empty" (. a cut :destination b))
(defmacro (duplicate-row r n) "copy one whole row's contents and formatting onto another row" (. (rows r) copy :destination (rows n)))
(defmacro (clear-everything-from r) "clear a range's values, formulas, and formatting entirely" (. r clear))
(defmacro (delete-shift-up r) "delete a range and shift the cells below it up" (. r delete :shift xlshiftup))
(defmacro (delete-shift-left r) "delete a range and shift the cells to its right left" (. r delete :shift xlshifttoleft))
(defmacro (delete-blank-rows r) "delete every row that has a blank cell within a range" (vladeleteblankrows r))
(defmacro (trim-this-sheet) "remove every trailing empty row and column past the sheet's real used extent" (vlatrimsheet))
(defmacro (band-rows r c) "shade every other row of a range with a fill color, starting at the range's own 2nd row" (vlabandrows r c))
(defmacro (make-header-row r) "make a row read as a table header: bold text and a light fill - freeze or filter it with their own separate sentences if wanted" (begin (make-bold (rows r)) (set-fill-color (rows r) (vlacolor "#D9D9D9"))))
(defmacro (fill-series r n s kind) "fill a range with a linear or growth series starting at a value, with an optional step" (vlafillseries r n s kind))
(defmacro (make-not-bold r) "turn a range's bold off" (set! (. r font.bold) false))
(defmacro (make-not-italic r) "turn a range's italic off" (set! (. r font.italic) false))
(defmacro (underline-text r) "give a range's text a single underline" (set! (. r font.underline) xlunderlinestylesingle))
(defmacro (strike-through-text r) "draw a line through a range's text" (set! (. r font.strikethrough) true))
(defmacro (remove-underline r) "take the underline off a range's text" (set! (. r font.underline) xlunderlinestylenone))
(defmacro (remove-strikethrough r) "take the strikethrough line off a range's text" (set! (. r font.strikethrough) false))
(defmacro (remove-borders r) "remove every border line from a range, edges and inside lines alike" (set! (. r borders.linestyle) xlnone))
(defmacro (set-font-name r n) "set a range's typeface by name" (set! (. r font.name) n))
(defmacro (align-top r) "align a range's contents to the top of each cell" (set! (. r verticalalignment) xltop))
(defmacro (align-middle r) "align a range's contents to the middle of each cell" (set! (. r verticalalignment) xlcenter))
(defmacro (align-bottom r) "align a range's contents to the bottom of each cell" (set! (. r verticalalignment) xlbottom))
(defmacro (set-indent r n) "indent a range's contents by a number of levels" (set! (. r indentlevel) n))
(defmacro (set-text-rotation r n) "rotate a range's text by an angle in degrees" (set! (. r orientation) n))
(defmacro (add-edge-border r edge) "draw a continuous line along one edge of a range" (set! (. (. r borders edge) linestyle) xlcontinuous))
(defmacro (add-outline-border r) "draw a box around the outside of a range, leaving its inside lines alone" (begin (add-edge-border r xledgetop) (add-edge-border r xledgebottom) (add-edge-border r xledgeleft) (add-edge-border r xledgeright)))
(defmacro (add-edge-border-in r edge c) "draw one edge of a range as a continuous line in a color" (begin (add-edge-border r edge) (set! (. (. r borders edge) color) c)))
(defmacro (add-outline-border-in r c) "draw a box around the outside of a range in a color, leaving its inside lines alone" (begin (add-edge-border-in r xledgetop c) (add-edge-border-in r xledgebottom c) (add-edge-border-in r xledgeleft c) (add-edge-border-in r xledgeright c)))
(defmacro (add-border-in r c) "draw every line of every cell in a range, in a color" (begin (add-border r) (set! (. r borders.color) c)))
(defmacro (format-as-dollars r n) "apply a dollar currency format with a number of decimal places" (set! (. r numberformat) (vlanumberformatcode "dollars" n)))
(defmacro (format-as-euros r n) "apply a euro currency format with a number of decimal places" (set! (. r numberformat) (vlanumberformatcode "euros" n)))
(defmacro (format-as-pounds r n) "apply a pound sterling currency format with a number of decimal places" (set! (. r numberformat) (vlanumberformatcode "pounds" n)))
(defmacro (format-as-accounting-dollars r n) "apply the accounting layout in dollars: sign at the left, negatives in brackets, zero as a dash" (set! (. r numberformat) (vlanumberformatcode "accounting-dollars" n)))
(defmacro (format-as-accounting-euros r n) "apply the accounting layout in euros: sign at the left, negatives in brackets, zero as a dash" (set! (. r numberformat) (vlanumberformatcode "accounting-euros" n)))
(defmacro (format-as-accounting-pounds r n) "apply the accounting layout in pounds: sign at the left, negatives in brackets, zero as a dash" (set! (. r numberformat) (vlanumberformatcode "accounting-pounds" n)))
(defmacro (format-as-percent-with-decimals r n) "apply a percent format with a number of decimal places" (set! (. r numberformat) (vlanumberformatcode "percent" n)))
(defmacro (format-as-number r n) "apply a plain number format with a number of decimal places and no thousands separators" (set! (. r numberformat) (vlanumberformatcode "number" n)))
(defmacro (format-as-separated-number r n) "apply a number format with thousands separators and a number of decimal places" (set! (. r numberformat) (vlanumberformatcode "number-separated" n)))
(defmacro (format-as-short-date r) "apply the reading machine's own short date format" (set! (. r numberformat) "m/d/yyyy"))
(defmacro (format-as-long-date r) "apply the reading machine's own long date format" (set! (. r numberformat) "[$-F800]dddd, mmmm dd, yyyy"))
(defmacro (format-as-iso-date r) "apply the ISO date format, year-month-day, the same on every machine" (set! (. r numberformat) "yyyy-mm-dd"))
(defmacro (format-as-time r) "apply the reading machine's own time format" (set! (. r numberformat) "[$-F400]h:mm:ss AM/PM"))
(defmacro (format-as-text-for-new-entries r) "make a range treat values typed into it later as text; numbers already there stay numbers" (set! (. r numberformat) "@"))
(defmacro (format-as-general r) "remove a range's number format, back to Excel's General" (set! (. r numberformat) "General"))
(defmacro (format-using r pattern) "apply an Excel number format code, written in Excel's own US syntax" (set! (. r numberformat) pattern))
(defmacro (sort-with-header r c order) "sort a range by one of its columns, keeping the range's first row in place as its header" (. r sort :key1 (. r columns (vlacolumninrange r c)) :order1 order :header xlyes))
(defmacro (sort-without-header r c order) "sort every row of a range by one of its columns - no header row held back" (. r sort :key1 (. r columns (vlacolumninrange r c)) :order1 order :header xlno))
(defmacro (sort-two-with-header r c order e order2) "sort a range by one column and then another, keeping the range's first row in place as its header" (. r sort :key1 (. r columns (vlacolumninrange r c)) :order1 order :key2 (. r columns (vlacolumninrange r e)) :order2 order2 :header xlyes))
(defmacro (sort-two-without-header r c order e order2) "sort every row of a range by one column and then another - no header row held back" (. r sort :key1 (. r columns (vlacolumninrange r c)) :order1 order :key2 (. r columns (vlacolumninrange r e)) :order2 order2 :header xlno))
(defmacro (used-range) "the active sheet's used range - every row and column holding data or formatting" (. activesheet usedrange))
(defmacro (add-filters r) "turn on filter buttons for a range's header row - nothing is hidden until a condition is set" (vlaaddfilters r))
(defmacro (remove-filters) "take the active sheet's filter buttons away, showing every row again" (set! (. activesheet autofiltermode) false))
(defmacro (filter-to-show-matching r c v) "hide every row of a range except those whose column holds a value - the value itself, whatever the cell's number format" (. r autofilter :field (vlafilterfield r c) :criteria1 (vlafiltercriterion "at-least" v) :operator xland :criteria2 (vlafiltercriterion "at-most" v)))
(defmacro (filter-to-show-condition r c condition) "hide every row of a range except those whose column meets one AutoFilter condition" (. r autofilter :field (vlafilterfield r c) :criteria1 condition))
(defmacro (filter-to-show-containing r c v) "hide every row of a range except those whose column contains a piece of text" (filter-to-show-condition r c (vlafiltercriterion "contains" v)))
(defmacro (filter-to-show-greater-than r c v) "hide every row of a range except those whose column holds a number greater than a value" (filter-to-show-condition r c (vlafiltercriterion "greater" v)))
(defmacro (filter-to-show-less-than r c v) "hide every row of a range except those whose column holds a number less than a value" (filter-to-show-condition r c (vlafiltercriterion "less" v)))
(defmacro (copy-visible-cells a b) "copy only a range's visible cells to another place - rows and columns hidden by a filter or by hand stay behind" (. (. a specialcells xlcelltypevisible) copy :destination b))
(defmacro (clear-contents r) "erase a range's values, keep its formatting" (. r clearcontents))
(defmacro (fill-down r) "copy the top row of a range down through it" (. r filldown))
(defmacro (fill-right r) "copy the left column of a range right through it" (. r fillright))
(defmacro (make-bold r) "turn a range's font bold" (set! (. r font.bold) true))
(defmacro (make-italic r) "turn a range's font italic" (set! (. r font.italic) true))
(defmacro (method-antonym-family name param target pos-method neg-method doc-pos doc-neg) "generate a method-call antonym pair sharing one target-and-method shape, no extra arguments" (begin (defmacro (name param) doc-pos (. target pos-method)) (defmacro ((symbol "un" name) param) doc-neg (. target neg-method))))
(defmacro (merge-range r) "merge a range into one cell" (. r merge))
(defmacro (unmerge-range r) "split a merged range back into cells" (. r unmerge))
(defmacro (protect-sheet ws pw) "protect a worksheet with a password" (. ws protect :password pw))
(defmacro (set-alignment r a) "set a range's horizontal alignment (xl constant)" (set! (. r horizontalalignment) a))
(defmacro (set-column-width c w) "set a column's width in characters" (set! (. c columnwidth) w))
(defmacro (set-fill-color r c) "set a range's background fill color" (set! (. r interior.color) c))
(defmacro (set-font-color r c) "set a range's font color" (set! (. r font.color) c))
(defmacro (set-font-size r n) "set a range's font size in points" (set! (. r font.size) n))
(defmacro (unprotect-sheet ws pw) "remove a worksheet's password protection" (. ws unprotect :password pw))
(defmacro (copy-range-to a b) "copy a range's cells into another range" (. a copy :destination b))
(defmacro (paste-values a b) "copy a range's values only - no formatting or formulas - into another range" (begin (. a copy) (. b pastespecial :paste xlpastevalues) (set! application.cutcopymode false)))
(defmacro (clear-color r) "remove a range's fill color" (set! (. r interior.colorindex) xlnone))
(defmacro (format-as-currency r) "apply a currency number-format to a range" (set! (. r numberformat) "$#,##0.00"))
(defmacro (format-as-percent r) "apply a percent number-format to a range" (set! (. r numberformat) "0.0%"))
(defmacro (format-as-date r) "apply a date number-format to a range" (set! (. r numberformat) "mm/dd/yyyy"))
(defmacro (add-border r) "add a continuous-line border around a range" (set! (. r borders.linestyle) xlcontinuous))
(defmacro (delete-row n) "delete a whole row" (. (rows n) delete))
(defmacro (insert-row-at n) "insert a blank row" (. (rows n) insert))
(defmacro (delete-column c) "delete a whole column" (. (columns c) delete))
(defmacro (bool-antonym-family name param target property doc-pos doc-neg) "generate a boolean-property on/off macro pair sharing one target-and-property shape" (begin (defmacro (name param) doc-pos (set! (. target property) true)) (defmacro ((symbol "un" name) param) doc-neg (set! (. target property) false))))
(defmacro (hide-column c) "hide a column" (set! (. (columns c) hidden) true))
(defmacro (unhide-column c) "show a hidden column" (set! (. (columns c) hidden) false))
(defmacro (insert-column c) "insert a blank column" (. (columns c) insert))
(defmacro (fit-column c) "autofit a column's width to its contents" (. (columns c) autofit))
(defmacro (fit-all-columns) "autofit every column's width to its contents" (. cells entirecolumn.autofit))
(defmacro (freeze-top-row) "freeze the sheet's header row" (begin (. (rows 2) select) (set! activewindow.freezepanes true)))
(defmacro (unfreeze-panes) "remove any frozen rows or columns" (set! (. activewindow freezepanes) false))
(defmacro (sort-range-by r k order) "sort a range by one column" (. r sort :key1 k :order1 order :header xlyes))
(defmacro (activate-sheet s) "make a sheet the active sheet - fails if it does not exist" (. (worksheets s) activate))
(defmacro (add-sheet-called s) "add a new sheet with a given name" (begin (vlachecksheetname s) (vlachecksheetabsent s) (worksheets.add) (set! activesheet.name s)))
(defmacro (delete-sheet s) "delete a sheet without the confirmation prompt" (begin (set! application.displayalerts false) (. (worksheets s) delete) (set! application.displayalerts true)))
(defmacro (open-workbook p) "open a workbook file" (. workbooks open p))
(defmacro (save-workbook-as p) "save this workbook to a new path" (. thisworkbook saveas p))
(defmacro (close-workbook) "close this workbook, saving changes" (. thisworkbook close :savechanges true))
(defmacro (refresh-everything) "refresh every data connection and pivot table" (. activeworkbook refreshall))
(defmacro (print-this-sheet) "open the print preview for this sheet" (. activesheet printout :preview true))
(defmacro (wait-seconds n) "pause for a number of seconds" (. application wait (+ (now) (timeserial 0 0 n))))
(defmacro (wrap-text r) "turn on a range's text wrapping" (set! (. r wraptext) true))
(defmacro (unwrap-text r) "turn off a range's text wrapping" (set! (. r wraptext) false))
(defmacro (replace-in a b target) "find and replace text within a range or column" (. target replace :what a :replacement b))
(defmacro (clear-formatting r) "remove all formatting from a range, keeping its values" (. r clearformats))
(defmacro (set-row-height n h) "set a row's height in points" (set! (. (rows n) rowheight) h))
(defmacro (hide-row n) "hide a row" (set! (. (rows n) hidden) true))
(defmacro (unhide-row n) "show a hidden row" (set! (. (rows n) hidden) false))
(defmacro (set-tab-color s c) "set a sheet tab's color" (set! (. (worksheets s) tab.color) c))
(defmacro (copy-range-to-sheet rExpr s rRef) "copy a range into the same address on another sheet" (. rExpr copy :destination (. (worksheets s) range rRef)))
(defmacro (remove-duplicates r cols) "remove duplicate rows from a range, keyed by one or more columns" (. r removeduplicates :columns cols :header xlyes))
(defmacro (name-range r n) "give a range a workbook-level name, usable in formulas" (begin (vlacheckrangename n) (set! (. r name) n)))
(defmacro (put-into-cell-of-sheet e r s) "write a value into a cell on another sheet" (set! (. (worksheets s) range r) e))
(defmacro (cell-of-sheet r s) "read a cell's value from another sheet" (. (worksheets s) range r))
(defmacro (filter-rows r field criteria) "hide every row of a range whose column doesn't match" (. r autofilter :field field :criteria1 criteria))
(defmacro (show-all-rows) "remove any active filter, showing every row again" (begin (on-error resume-next) (. activesheet showalldata) (on-error goto 0)))
(defmacro (last-filled-row c) "the row number of the last non-empty cell in a column" (. (. (cells rows.count c) end xlup) row))
(defmacro (export-sheet-as-pdf p) "export this sheet as a PDF file" (. activesheet exportasfixedformat :type xltypepdf :filename p))
(defmacro (save-copy-as p) "save a copy of this workbook without changing the open file" (. activeworkbook savecopyas p))
(defmacro (save-current-workbook) "save this workbook" (. thisworkbook save))
(defmacro (set-screen-updating on) "turn Excel's screen redraw on or off" (set! application.screenupdating on))
(defmacro (set-status-bar text) "show text in the status bar, or false to clear it" (set! application.statusbar text))
(defmacro (sum-of r) "the sum of a range or list of numbers" (application.worksheetfunction.sum r))
(defmacro (average-of r) "the average of a range or list of numbers" (application.worksheetfunction.average r))
(defmacro (largest-of r) "the largest value in a range or list" (application.worksheetfunction.max r))
(defmacro (smallest-of r) "the smallest value in a range or list" (application.worksheetfunction.min r))
(defmacro (lookup-of e r k) "look up a value in a range's first column, reading across to another column - fails if not found" (application.worksheetfunction.vlookup e r k false))
(defmacro (sum-of-where r c e) "the sum of one range's cells where a matching range meets a condition" (application.worksheetfunction.sumif c e r))
(defmacro (count-matching c e) "count a range's cells that match a condition" (application.worksheetfunction.countif c e))
(defmacro (vla-stamp-cell r v) "write a value into a cell and make it bold - the phrasebook demo macro" (begin (set! (range r) v) (make-bold (range r))))
(defmacro (datalog-filter-place table shown filtercol op val alias r) "write a =DATALOG(...) named-column filter query as a live formula" (set-formula r (interpolate "=DATALOG(\"(rule ({alias} X) ({table} ({shown} X) ({filtercol} S)) ({op} S {val})) (query {alias})\", {table})" :alias alias :table table :shown shown :filtercol filtercol :op op :val val)))
(defmacro (datalog-chain-place table person alias r) "write a =DATALOG(...) transitive two-column reachability query as a live formula" (set-formula r (interpolate "=DATALOG(\"(rule (vlachain X Y) ({table} X Y)) (rule (vlachain X Y) ({table} X Z) (vlachain Z Y)) (rule ({alias} X) (vlachain X \"\"{person}\"\")) (query {alias})\", {table})" :table table :person person :alias alias)))

