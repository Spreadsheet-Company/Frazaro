; SPDX-License-Identifier: MPL-2.0
; deutsche.vla - der deutsche Zwilling von pirate.vla/latin.vla/
; espanol.vla, dieselben Makros, derselbe Umfang, ein weiterer Beweis,
; dass <lingua>-vla-Dialekte reiner Oberflachentext ueber einer
; einzigen gemeinsamen Schicht aus Vorlagen und Makros sind. Lade
; zuerst english.vla, damit diese Makros existieren, dann lade diese
; Datei.
;
; Keine Umlaute oder Eszett hier unten - "entferne" steht anstelle von
; "loesche" (delete) und "schliesse" schreibt das Eszett in "schlie?e"
; (close) als "ss", die uebliche ASCII-Ersetzung - dieselbe
; ASCII-Hygiene-Entscheidung, die espanol.vla fuer seine eigenen
; Akzente trifft, keine Behauptung, dass ein Muttersprachler es so
; schreiben wuerde. Substantive behalten die deutsche Grossschreibung
; (Zelle, Formel, Bereich...), da das nichts kostet und authentisch
; klingt.
;
; {d:bold|italic}, {d:red|yellow}, {d:hide|unhide} bleiben die
; woertlichen englischen Woerter - sie binden sich direkt an den
; Makronamen (make-{d}, vb{d}, {d}-column) genau wie in den anderen
; drei Dialektdateien; nur die tragende Phrase ist deutsch.
;
; Nicht gegen die laufende Engine getestet (Blindschreib-Disziplin) -
; Check Sentences / Reload Vocabulary ist die eigentliche Probe.

(deutsche-vla
    "setze die Formel {f:text} in Zelle {r:cell}"
    (set-formula (range {r}) {f}))
(test-success
    "Setze die Formel \"=B2*2\" in Zelle B3."
    (set-formula (range "b3") "=B2*2"))

(deutsche-vla
    "setze {e:expr} in Zelle {r:cell}"
    (set! (range {r}) {e}))
(test-success
    "Setze 5 in Zelle B2."
    (set! (range "b2") 5))

(deutsche-vla
    "setze heute in Zelle {r:cell}"
    (set! (range {r}) (date)))
(test-success
    "Setze heute in Zelle D1."
    (set! (range "d1") (date)))

(deutsche-vla
    "mache Zelle {r:cell} {d:bold|italic}"
    (make-{d} (range {r})))
(test-success
    "Mache Zelle A1 bold."
    (make-bold (range "a1")))

(deutsche-vla
    "male Zelle {r:cell} {d:red|yellow}"
    (set-fill-color (range {r}) vb{d}))
(test-success
    "Male Zelle C4 red."
    (set-fill-color (range "c4") vbred))

(deutsche-vla
    "entferne Zeile {n:expr}"
    (delete-row {n}))
(test-success
    "Entferne Zeile 5."
    (delete-row 5))

(deutsche-vla
    "entferne Spalte {c:column}"
    (delete-column {c}))
(test-success
    "Entferne Spalte C."
    (delete-column "c"))

(deutsche-vla
    "{d:hide|unhide} Spalte {c:column}"
    ({d}-column {c}))
(test-success
    "Hide Spalte C."
    (hide-column "c"))
(test-success
    "Unhide Spalte C."
    (unhide-column "c"))

(deutsche-vla
    "leere Zelle|Bereich {r:range}"
    (clear-contents (range {r})))
(test-success
    "Leere Bereich \"A1:C10\"."
    (clear-contents (range "A1:C10")))

(deutsche-vla
    "umrande Bereich {r:range}"
    (add-border (range {r})))
(test-success
    "Umrande Bereich \"A1:C10\"."
    (add-border (range "A1:C10")))

(deutsche-vla
    "sortiere Bereich {r:range} nach Spalte {k:cell} absteigend"
    (sort-range-by (range {r}) (range {k}) xldescending))
(test-success
    "Sortiere Bereich \"A1:C50\" nach Spalte B1 absteigend."
    (sort-range-by (range "A1:C50") (range "b1") xldescending))

(deutsche-vla
    "arbeite an Blatt {s:sheet}"
    (begin (vlaensuresheet {s}) (activate-sheet {s})))
(test-success
    "Arbeite an Blatt Results."
    (begin (vlaensuresheet "results") (activate-sheet "results")))

(deutsche-vla
    "erstelle ein Blatt namens {s:sheet}"
    (add-sheet-called {s}))
(test-success
    "Erstelle ein Blatt namens \"Schatz\"."
    (add-sheet-called "Schatz"))

(deutsche-vla
    "erstelle einen Knopf namens {c:text} bei Zelle {r:cell}"
    (make-button {c} (range {r})))
(test-success
    "Erstelle einen Knopf namens \"Recalculate Totals\" bei Zelle D3."
    (make-button "Recalculate Totals" (range "d3")))

(deutsche-vla
    "setze {e:expr} in die Statusleiste"
    (set-status-bar {e}))
(test-success
    "Setze \"bereit\" in die Statusleiste."
    (set-status-bar "bereit"))

(deutsche-vla
    "leere die Statusleiste"
    (set-status-bar false))
(test-success
    "Leere die Statusleiste."
    (set-status-bar false))

(deutsche-vla
    "warte {n:expr} Sekunden"
    (wait-seconds {n}))
(test-success
    "Warte 2 Sekunden."
    (wait-seconds 2))

(deutsche-vla
    "schliesse diese Arbeitsmappe"
    (close-workbook))
(test-success
    "Schliesse diese Arbeitsmappe."
    (close-workbook))

(deutsche-vla
    "sende eine Mail an {who:expr} mit Betreff {s:expr} und Nachricht {m:expr}"
    (vlasendmail {who} {s} {m}))
(test-success
    "Sende eine Mail an \"boss@co.com\" mit Betreff \"Report\" und Nachricht \"Attached.\"."
    (vlasendmail "boss@co.com" "Report" "Attached."))



