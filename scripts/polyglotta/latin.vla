; SPDX-License-Identifier: MPL-2.0
; latin.vla - gemellus Latinus ipsius pirate.vla: eaedem macros, eadem
; probatio, secundum testimonium dialectos <lingua>-vla esse merum
; textum superficiei super unum stratum commune formularum et macrorum.
; Onera prius english.vla, ut hae macros iam exsistant, deinde onera
; hoc scriptum.
;
; Notae de vocabulis (voces Neolatinae novatae signatae, eodem consilio
; quo huius operis doctrina propria "Store est verbum Anglicum
; idiomaticum vasis" - iudicium linguisticum semel factum, hic scriptum
; ne iterum disputetur):
;   cellula    - "cell" (cubiculum parvum; verbum Neolatinum hodiernum
;                pro cellula tabulae, pilae, aut biologiae)
;   regio      - "range" (spatium)
;   columna    - "column" (a Latina immutata)
;   versus     - "row" (linea aut sulcus - etiam origo vocis Anglicae
;                "verse")
;   tabula     - "sheet" (asser aut tabella; folia libri "tabulae"
;                vocantur)
;   bulla      - "button" (nodus vel umbo - nulla vox classica pro
;                elemento interfaciei quod premitur exsistit; haec est
;                proxima analogia physica)
;   linea-status / volumen - composita ficta pro "status bar" et
;                "workbook", anachronismi sine origine Latina, aperte
;                scripti, non aliter simulati
;
; {d:bold|italic}, {d:red|yellow}, {d:hide|unhide} manent verba Anglica
; litteralia - haec directe in nomen macronis alligantur (make-{d},
; vb{d}, {d}-column) sicut in pirate.vla; sola phrasis circumiacens
; Latina est.
;
; Nondum probatum contra machinam vivam (disciplina scribendi sine
; visu) - Check Sentences / Reload Vocabulary verum experimentum est.

(latin-vla
    "pone formulam {f:text} in cellula {r:cell}"
    (set-formula (range {r}) {f}))
(test-success
    "Pone formulam \"=B2*2\" in cellula B3."
    (set-formula (range "b3") "=B2*2"))

(latin-vla
    "pone {e:expr} in cellula {r:cell}"
    (set! (range {r}) {e}))
(test-success
    "Pone 5 in cellula B2."
    (set! (range "b2") 5))

(latin-vla
    "pone hodie in cellula {r:cell}"
    (set! (range {r}) (date)))
(test-success
    "Pone hodie in cellula D1."
    (set! (range "d1") (date)))

(latin-vla
    "fac cellulam {r:cell} {d:bold|italic}"
    (make-{d} (range {r})))
(test-success
    "Fac cellulam A1 bold."
    (make-bold (range "a1")))

(latin-vla
    "pinge cellulam {r:cell} {d:red|yellow}"
    (set-fill-color (range {r}) vb{d}))
(test-success
    "Pinge cellulam C4 red."
    (set-fill-color (range "c4") vbred))

(latin-vla
    "dele versum {n:expr}"
    (delete-row {n}))
(test-success
    "Dele versum 5."
    (delete-row 5))

(latin-vla
    "dele columnam {c:column}"
    (delete-column {c}))
(test-success
    "Dele columnam C."
    (delete-column "c"))

(latin-vla
    "{d:hide|unhide} columnam {c:column}"
    ({d}-column {c}))
(test-success
    "Hide columnam C."
    (hide-column "c"))
(test-success
    "Unhide columnam C."
    (unhide-column "c"))

(latin-vla
    "munda cellulam|regionem {r:range}"
    (clear-contents (range {r})))
(test-success
    "Munda regionem \"A1:C10\"."
    (clear-contents (range "A1:C10")))

(latin-vla
    "adde marginem regioni {r:range}"
    (add-border (range {r})))
(test-success
    "Adde marginem regioni \"A1:C10\"."
    (add-border (range "A1:C10")))

(latin-vla
    "ordina regionem {r:range} secundum columnam {k:cell} decrescenter"
    (sort-range-by (range {r}) (range {k}) xldescending))
(test-success
    "Ordina regionem \"A1:C50\" secundum columnam B1 decrescenter."
    (sort-range-by (range "A1:C50") (range "b1") xldescending))

(latin-vla
    "labora in tabula {s:sheet}"
    (begin (vlaensuresheet {s}) (activate-sheet {s})))
(test-success
    "Labora in tabula Results."
    (begin (vlaensuresheet "results") (activate-sheet "results")))

(latin-vla
    "adde tabulam nomine {s:sheet}"
    (add-sheet-called {s}))
(test-success
    "Adde tabulam nomine \"Thesaurus\"."
    (add-sheet-called "Thesaurus"))

(latin-vla
    "fac bullam nomine {c:text} ad cellulam {r:cell}"
    (make-button {c} (range {r})))
(test-success
    "Fac bullam nomine \"Recalculate Totals\" ad cellulam D3."
    (make-button "Recalculate Totals" (range "d3")))

(latin-vla
    "pone {e:expr} in linea-status"
    (set-status-bar {e}))
(test-success
    "Pone \"paratus\" in linea-status."
    (set-status-bar "paratus"))

(latin-vla
    "munda linea-status"
    (set-status-bar false))
(test-success
    "Munda linea-status."
    (set-status-bar false))

(latin-vla
    "exspecta {n:expr} secunda"
    (wait-seconds {n}))
(test-success
    "Exspecta 2 secunda."
    (wait-seconds 2))

(latin-vla
    "claude hoc volumen"
    (close-workbook))
(test-success
    "Claude hoc volumen."
    (close-workbook))

(latin-vla
    "mitte nuntium ad {who:expr} cum titulo {s:expr} et nuntio {m:expr}"
    (vlasendmail {who} {s} {m}))
(test-success
    "Mitte nuntium ad \"boss@co.com\" cum titulo \"Report\" et nuntio \"Attached.\"."
    (vlasendmail "boss@co.com" "Report" "Attached."))



