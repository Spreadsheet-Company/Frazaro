; SPDX-License-Identifier: MPL-2.0
; francais.vla - le jumeau francais de pirate.vla/latin.vla/
; espanol.vla/deutsche.vla/esperanto.vla, les memes macros, la meme
; couverture, une preuve de plus que les dialectes <lingua>-vla sont
; du pur texte de surface au-dessus d'une seule couche partagee de
; gabarits et de macros. Charge d'abord english.vla pour que ces
; macros existent, puis charge ce fichier.
;
; Les accents francais (decroissant, nommee, pret, tresor, a...) sont
; ecrits ci-dessous sans diacritiques - la meme decision d'hygiene
; ASCII que les autres dialectes appliquent a leurs propres signes,
; pas une pretention que c'est l'orthographe standard.
;
; {d:bold|italic}, {d:red|yellow}, {d:hide|unhide} restent les mots
; anglais litteraux - ils se lient directement au nom de la macro
; (make-{d}, vb{d}, {d}-column) exactement comme dans les autres
; fichiers de dialecte; seule la phrase porteuse est en francais.
;
; Non verifie contre le moteur reel (discipline d'ecriture a l'aveugle)
; - Check Sentences / Reload Vocabulary est la vraie epreuve.

(francais-vla
    "mets la formule {f:text} dans la cellule {r:cell}"
    (set-formula (range {r}) {f}))
(test-success
    "Mets la formule \"=B2*2\" dans la cellule B3."
    (set-formula (range "b3") "=B2*2"))

(francais-vla
    "mets {e:expr} dans la cellule {r:cell}"
    (set! (range {r}) {e}))
(test-success
    "Mets 5 dans la cellule B2."
    (set! (range "b2") 5))

(francais-vla
    "mets la date dans la cellule {r:cell}"
    (set! (range {r}) (date)))
(test-success
    "Mets la date dans la cellule D1."
    (set! (range "d1") (date)))

(francais-vla
    "rends la cellule {r:cell} {d:bold|italic}"
    (make-{d} (range {r})))
(test-success
    "Rends la cellule A1 bold."
    (make-bold (range "a1")))

(francais-vla
    "peins la cellule {r:cell} {d:red|yellow}"
    (set-fill-color (range {r}) vb{d}))
(test-success
    "Peins la cellule C4 red."
    (set-fill-color (range "c4") vbred))

(francais-vla
    "supprime la ligne {n:expr}"
    (delete-row {n}))
(test-success
    "Supprime la ligne 5."
    (delete-row 5))

(francais-vla
    "supprime la colonne {c:column}"
    (delete-column {c}))
(test-success
    "Supprime la colonne C."
    (delete-column "c"))

(francais-vla
    "{d:hide|unhide} la colonne {c:column}"
    ({d}-column {c}))
(test-success
    "Hide la colonne C."
    (hide-column "c"))
(test-success
    "Unhide la colonne C."
    (unhide-column "c"))

(francais-vla
    "efface la cellule|plage {r:range}"
    (clear-contents (range {r})))
(test-success
    "Efface la plage \"A1:C10\"."
    (clear-contents (range "A1:C10")))

(francais-vla
    "ajoute une bordure a la plage {r:range}"
    (add-border (range {r})))
(test-success
    "Ajoute une bordure a la plage \"A1:C10\"."
    (add-border (range "A1:C10")))

(francais-vla
    "trie la plage {r:range} par colonne {k:cell} decroissant"
    (sort-range-by (range {r}) (range {k}) xldescending))
(test-success
    "Trie la plage \"A1:C50\" par colonne B1 decroissant."
    (sort-range-by (range "A1:C50") (range "b1") xldescending))

(francais-vla
    "travaille sur la feuille {s:sheet}"
    (begin (vlaensuresheet {s}) (activate-sheet {s})))
(test-success
    "Travaille sur la feuille Results."
    (begin (vlaensuresheet "results") (activate-sheet "results")))

(francais-vla
    "cree une feuille nommee {s:sheet}"
    (add-sheet-called {s}))
(test-success
    "Cree une feuille nommee \"Tresor\"."
    (add-sheet-called "Tresor"))

(francais-vla
    "cree un bouton nomme {c:text} a la cellule {r:cell}"
    (make-button {c} (range {r})))
(test-success
    "Cree un bouton nomme \"Recalculate Totals\" a la cellule D3."
    (make-button "Recalculate Totals" (range "d3")))

(francais-vla
    "mets {e:expr} dans la barre de statut"
    (set-status-bar {e}))
(test-success
    "Mets \"pret\" dans la barre de statut."
    (set-status-bar "pret"))

(francais-vla
    "efface la barre de statut"
    (set-status-bar false))
(test-success
    "Efface la barre de statut."
    (set-status-bar false))

(francais-vla
    "attends {n:expr} secondes"
    (wait-seconds {n}))
(test-success
    "Attends 2 secondes."
    (wait-seconds 2))

(francais-vla
    "ferme ce classeur"
    (close-workbook))
(test-success
    "Ferme ce classeur."
    (close-workbook))

(francais-vla
    "envoie un courriel a {who:expr} avec objet {s:expr} et message {m:expr}"
    (vlasendmail {who} {s} {m}))
(test-success
    "Envoie un courriel a \"boss@co.com\" avec objet \"Report\" et message \"Attached.\"."
    (vlasendmail "boss@co.com" "Report" "Attached."))



