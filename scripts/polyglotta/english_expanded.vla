    (sort-{h}-header (used-range) {c} xl{d}))
(test-success
    "Sort this sheet by column B descending with a header row."
    (sort-with-header (used-range) "b" xldescending))
(test-success
    "Sort this sheet by column B ascending without a header."
    (sort-without-header (used-range) "b" xlascending))
(defmacro
    (add-filters r)
    "turn on filter buttons for a range's header row - nothing is hidden until a condition is set"
    (vlaaddfilters r))

(english-vla
    "add filter/s to range {r:range}"
    (add-filters (range {r})))
(test-success
    "Add filters to range A1:D50."
    (add-filters (range "a1:d50")))
(test-success
    "Add a filter to range A1:D50."
    (add-filters (range "a1:d50")))
(english-vla
    "clear filter condition/s"
    (show-all-rows))
(test-success
    "Clear the filter conditions."
    (show-all-rows))
(test-success
    "Clear the filter condition."
    (show-all-rows))
(defmacro
    (remove-filters)
    "take the active sheet's filter buttons away, showing every row again"
    (set! (. activesheet autofiltermode) false))

(english-vla
    "remove filter/s"
    (remove-filters))
(test-success
    "Remove the filters."
    (remove-filters))
(test-success
    "Remove the filter."
    (remove-filters))
(defmacro
    (filter-to-show-matching r c v)
    "hide every row of a range except those whose column holds a value - the value itself, whatever the cell's number format"
    (. r
       autofilter
       :field
       (vlafilterfield r c)
       :criteria1
       (vlafiltercriterion "at-least" v)
       :operator
       xland
       :criteria2
       (vlafiltercriterion "at-most" v)))

(defmacro
    (filter-to-show-condition r c condition)
    "hide every row of a range except those whose column meets one AutoFilter condition"
    (. r autofilter :field (vlafilterfield r c) :criteria1 condition))

(defmacro
    (filter-to-show-containing r c v)
    "hide every row of a range except those whose column contains a piece of text"
    (filter-to-show-condition r c (vlafiltercriterion "contains" v)))

(defmacro
    (filter-to-show-greater-than r c v)
    "hide every row of a range except those whose column holds a number greater than a value"
    (filter-to-show-condition r c (vlafiltercriterion "greater" v)))

(defmacro
    (filter-to-show-less-than r c v)
    "hide every row of a range except those whose column holds a number less than a value"
    (filter-to-show-condition r c (vlafiltercriterion "less" v)))

(english-vla
    "filter [range] {r:range} to show rows where column {c:column} is {v:expr}"
    (filter-to-show-matching (range {r}) {c} {v}))
(test-success
    "Filter range A1:D50 to show rows where column C is \"West\"."
    (filter-to-show-matching (range "a1:d50") "c" "West"))
(test-success
    "Filter A1:D50 to show rows where column D is 100."
    (filter-to-show-matching (range "a1:d50") "d" 100))
(test-fail
    "Filter range A1:D50 where column C is \"West\"."
    "then I expected 'to'")
(english-vla
    "filter [range] {r:range} to show rows where column {c:column} contains {v:expr}"
    (filter-to-show-containing (range {r}) {c} {v}))
(test-success
    "Filter range A1:D50 to show rows where column C contains \"we\"."
    (filter-to-show-containing (range "a1:d50") "c" "we"))
(english-vla
    "filter [range] {r:range} to show rows where column {c:column} is {d:greater|less} than {v:expr}"
    (filter-to-show-{d}-than (range {r}) {c} {v}))
(test-success
    "Filter range A1:D50 to show rows where column D is greater than 100."
    (filter-to-show-greater-than (range "a1:d50") "d" 100))
(test-success
    "Filter A1:D50 to show rows where column D is less than limit."
    (filter-to-show-less-than (range "a1:d50") "d" limit))
(defmacro
    (copy-visible-cells a b)
    "copy only a range's visible cells to another place - rows and columns hidden by a filter or by hand stay behind"
    (. (. a specialcells xlcelltypevisible) copy :destination b))

(english-vla
    "copy only visible cells of [range] {a:range} to [cell] {b:cell}"
    (copy-visible-cells (range {a}) (range {b})))
(test-success
    "Copy only the visible cells of range A1:D50 to F1."
    (copy-visible-cells (range "a1:d50") (range "f1")))
(test-success
    "Copy only the visible cells of A1:D50 to cell F1."
    (copy-visible-cells (range "a1:d50") (range "f1")))
(defmacro
    (clear-contents r)
    "erase a range's values, keep its formatting"
    (. r clearcontents))

(defmacro
    (fill-down r)
    "copy the top row of a range down through it"
    (. r filldown))

(defmacro
    (fill-right r)
    "copy the left column of a range right through it"
    (. r fillright))

(defmacro
    (make-bold r)
    "turn a range's font bold"
    (set! (. r font.bold) true))

(defmacro
    (make-italic r)
    "turn a range's font italic"
    (set! (. r font.italic) true))

(defmacro
    (method-antonym-family name param target pos-method neg-method doc-pos doc-neg)
    "generate a method-call antonym pair sharing one target-and-method shape, no extra arguments"
    (begin (defmacro
               (name param)
               doc-pos
               (. target pos-method))

           (defmacro
               ((symbol "un" name) param)
               doc-neg
               (. target neg-method))))

(defmacro
    (merge-range r)
    "merge a range into one cell"
    (. r merge))

(defmacro
    (unmerge-range r)
    "split a merged range back into cells"
    (. r unmerge))

(defmacro
    (protect-sheet ws pw)
    "protect a worksheet with a password"
    (. ws protect :password pw))

(defmacro
    (set-alignment r a)
    "set a range's horizontal alignment (xl constant)"
    (set! (. r horizontalalignment) a))

(defmacro
    (set-column-width c w)
    "set a column's width in characters"
    (set! (. c columnwidth) w))

(defmacro
    (set-fill-color r c)
    "set a range's background fill color"
    (set! (. r interior.color) c))

(defmacro
    (set-font-color r c)
    "set a range's font color"
    (set! (. r font.color) c))

(defmacro
    (set-font-size r n)
    "set a range's font size in points"
    (set! (. r font.size) n))

(defmacro
    (unprotect-sheet ws pw)
    "remove a worksheet's password protection"
    (. ws unprotect :password pw))

(defmacro
    (copy-range-to a b)
    "copy a range's cells into another range"
    (. a copy :destination b))

(defmacro
    (paste-values a b)
    "copy a range's values only - no formatting or formulas - into another range"
    (begin (. a copy) (. b pastespecial :paste xlpastevalues) (set! application.cutcopymode false)))

(defmacro
    (clear-color r)
    "remove a range's fill color"
    (set! (. r interior.colorindex) xlnone))

(defmacro
    (format-as-currency r)
    "apply a currency number-format to a range"
    (set! (. r numberformat) "$#,##0.00"))

(defmacro
    (format-as-percent r)
    "apply a percent number-format to a range"
    (set! (. r numberformat) "0.0%"))

(defmacro
    (format-as-date r)
    "apply a date number-format to a range"
    (set! (. r numberformat) "mm/dd/yyyy"))

(defmacro
    (add-border r)
    "add a continuous-line border around a range"
    (set! (. r borders.linestyle) xlcontinuous))

(defmacro
    (delete-row n)
    "delete a whole row"
    (. (rows n) delete))

(defmacro
    (insert-row-at n)
    "insert a blank row"
    (. (rows n) insert))

(defmacro
    (delete-column c)
    "delete a whole column"
    (. (columns c) delete))

(defmacro
    (bool-antonym-family name param target property doc-pos doc-neg)
    "generate a boolean-property on/off macro pair sharing one target-and-property shape"
    (begin (defmacro
               (name param)
               doc-pos
               (set! (. target property) true))

           (defmacro
               ((symbol "un" name) param)
               doc-neg
               (set! (. target property) false))))

(defmacro
    (hide-column c)
    "hide a column"
    (set! (. (columns c) hidden) true))

(defmacro
    (unhide-column c)
    "show a hidden column"
    (set! (. (columns c) hidden) false))

(defmacro
    (insert-column c)
    "insert a blank column"
    (. (columns c) insert))

(defmacro
    (fit-column c)
    "autofit a column's width to its contents"
    (. (columns c) autofit))

(defmacro
    (fit-all-columns)
    "autofit every column's width to its contents"
    (. cells entirecolumn.autofit))

(defmacro
    (freeze-top-row)
    "freeze the sheet's header row"
    (begin (. (rows 2) select) (set! activewindow.freezepanes true)))

(defmacro
    (unfreeze-panes)
    "remove any frozen rows or columns"
    (set! (. activewindow freezepanes) false))

(defmacro
    (sort-range-by r k order)
    "sort a range by one column"
    (. r sort :key1 k :order1 order :header xlyes))

(defmacro
    (activate-sheet s)
    "make a sheet the active sheet - fails if it does not exist"
    (. (worksheets s) activate))

(defmacro
    (add-sheet-called s)
    "add a new sheet with a given name"
    (begin (vlachecksheetname s) (vlachecksheetabsent s) (worksheets.add) (set! activesheet.name s)))

(defmacro
    (delete-sheet s)
    "delete a sheet without the confirmation prompt"
    (begin (set! application.displayalerts false)
           (. (worksheets s) delete)
           (set! application.displayalerts true)))

(defmacro
    (open-workbook p)
    "open a workbook file"
    (. workbooks open p))

(defmacro
    (save-workbook-as p)
    "save this workbook to a new path"
    (. thisworkbook saveas p))

(defmacro
    (close-workbook)
    "close this workbook, saving changes"
    (. thisworkbook close :savechanges true))

(defmacro
    (refresh-everything)
    "refresh every data connection and pivot table"
    (. activeworkbook refreshall))

(defmacro
    (print-this-sheet)
    "open the print preview for this sheet"
    (. activesheet printout :preview true))

(defmacro
    (wait-seconds n)
    "pause for a number of seconds"
    (. application wait (+ (now) (timeserial 0 0 n))))

(defmacro
    (wrap-text r)
    "turn on a range's text wrapping"
    (set! (. r wraptext) true))

(defmacro
    (unwrap-text r)
    "turn off a range's text wrapping"
    (set! (. r wraptext) false))

(defmacro
    (replace-in a b target)
    "find and replace text within a range or column"
    (. target replace :what a :replacement b))

(defmacro
    (clear-formatting r)
    "remove all formatting from a range, keeping its values"
    (. r clearformats))

(defmacro
    (set-row-height n h)
    "set a row's height in points"
    (set! (. (rows n) rowheight) h))

(defmacro
    (hide-row n)
    "hide a row"
    (set! (. (rows n) hidden) true))

(defmacro
    (unhide-row n)
    "show a hidden row"
    (set! (. (rows n) hidden) false))

(defmacro
    (set-tab-color s c)
    "set a sheet tab's color"
    (set! (. (worksheets s) tab.color) c))

(defmacro
    (copy-range-to-sheet rExpr s rRef)
    "copy a range into the same address on another sheet"
    (. rExpr copy :destination (. (worksheets s) range rRef)))

(defmacro
    (remove-duplicates r cols)
    "remove duplicate rows from a range, keyed by one or more columns"
    (. r removeduplicates :columns cols :header xlyes))

(defmacro
    (name-range r n)
    "give a range a workbook-level name, usable in formulas"
    (begin (vlacheckrangename n) (set! (. r name) n)))

(defmacro
    (put-into-cell-of-sheet e r s)
    "write a value into a cell on another sheet"
    (set! (. (worksheets s) range r) e))

(defmacro
    (cell-of-sheet r s)
    "read a cell's value from another sheet"
    (. (worksheets s) range r))

(defmacro
    (filter-rows r field criteria)
    "hide every row of a range whose column doesn't match"
    (. r autofilter :field field :criteria1 criteria))

(defmacro
    (show-all-rows)
    "remove any active filter, showing every row again"
    (begin (on-error resume-next) (. activesheet showalldata) (on-error goto 0)))

(defmacro
    (last-filled-row c)
    "the row number of the last non-empty cell in a column"
    (. (. (cells rows.count c) end xlup) row))

(defmacro
    (export-sheet-as-pdf p)
    "export this sheet as a PDF file"
    (. activesheet exportasfixedformat :type xltypepdf :filename p))

(defmacro
    (save-copy-as p)
    "save a copy of this workbook without changing the open file"
    (. activeworkbook savecopyas p))

(defmacro
    (save-current-workbook)
    "save this workbook"
    (. thisworkbook save))

(defmacro
    (set-screen-updating on)
    "turn Excel's screen redraw on or off"
    (set! application.screenupdating on))

(defmacro
    (set-status-bar text)
    "show text in the status bar, or false to clear it"
    (set! application.statusbar text))

(defmacro
    (sum-of r)
    "the sum of a range or list of numbers"
    (application.worksheetfunction.sum r))

(defmacro
    (average-of r)
    "the average of a range or list of numbers"
    (application.worksheetfunction.average r))

(defmacro
    (largest-of r)
    "the largest value in a range or list"
    (application.worksheetfunction.max r))

(defmacro
    (smallest-of r)
    "the smallest value in a range or list"
    (application.worksheetfunction.min r))

(defmacro
    (lookup-of e r k)
    "look up a value in a range's first column, reading across to another column - fails if not found"
    (application.worksheetfunction.vlookup e r k false))

(defmacro
    (sum-of-where r c e)
    "the sum of one range's cells where a matching range meets a condition"
    (application.worksheetfunction.sumif c e r))

(defmacro
    (count-matching c e)
    "count a range's cells that match a condition"
    (application.worksheetfunction.countif c e))

(defmacro
    (vla-stamp-cell r v)
    "write a value into a cell and make it bold - the phrasebook demo macro"
    (begin (set! (range r) v) (make-bold (range r))))

(english-vla
    "stamp {e:expr} into|in cell {r:cell}"
    (vla-stamp-cell {r} {e}))
(test-success
    "Stamp 5 into cell B2."
    (vla-stamp-cell "b2" 5))
(test-success
    "Stamp total in cell C3."
    (vla-stamp-cell "c3" total))
(english-vla
    "make a button [called] {c:text} at cell {r:cell}"
    (make-button {c} (range {r})))
(test-success
    "Make a button \"Recalculate Totals\" at cell D3."
    (make-button "Recalculate Totals" (range "d3")))
(test-success
    "Make a button called \"Recalculate Totals\" at cell D3."
    (make-button "Recalculate Totals" (range "d3")))
(test-fail
    "Sort range banana by column B1."
    "a range (like")
(test-fail
    "Put 1 onto cell A2."
    "one of 'into'/'in'")
(test-fail
    "Fit column banana."
    "a column letter")
(test-fail
    "Increase total by 5 plus 5%."
    "mixes % into a longer amount")
(test-fail
    "Set label to don't."
    "I don't understand the character")
(english-function
    "keys of"
    vladictkeys)
(english-function
    "largest of"
    largest-of)
(english-function
    "smallest of"
    smallest-of)
(english-function
    "sum of"
    sum-of)
(english-function
    "average of"
    average-of)
(test-success
    "Show total."
    (msgbox total))
(test-success
    "Show cell B2."
    (msgbox (range "b2")))
(test-success
    "Log total."
    (debug-print total))
(test-success
    "Log cell B2."
    (debug-print (range "b2")))
(test-success
    "Log \"step \" joined with counter."
    (debug-print (& "step " counter)))
(test-success
    "Set total to 0."
    (set! total 0))
(test-success
    "Increase total by 5."
    (add! total 5))
(test-success
    "Create a number called total."
    (dim total Double))
(test-success
    "If total is greater than 5, show \"big\"."
    (if (> total 5) (then (msgbox "big"))))
(test-success
    "If counter is divisible by 2, show \"even\"."
    (if (zero? (mod counter 2)) (then (msgbox "even"))))
(test-success
    "Repeat 2 times, show counter."
    (dotimes counter 2 (msgbox counter)))
(test-success
    "Count k from 2 to 9, show k."
    (for (k 2 9) (msgbox k)))
(test-success
    "Count k down from 9 to 2, show k."
    (for (k 9 2 -1) (msgbox k)))
(test-success
    "For each r in results, show r."
    (for-each (r results) (msgbox r)))
(test-success
    "While countdown is greater than 0, decrease countdown by 1."
    (while (> countdown 0) (set! countdown (- countdown 1))))
(test-success
    "If code contains \"x\", show \"hit\"."
    (if (positive? (instr 1 code "x" vbtextcompare)) (then (msgbox "hit"))))
(test-success
    "If code does not contain \"x\", show \"clean\"."
    (if (zero? (instr 1 code "x" vbtextcompare)) (then (msgbox "clean"))))
(test-success
    "If code starts with \"AB\", show \"ab\"."
    (if (= (instr 1 code "AB" vbtextcompare) 1) (then (msgbox "ab"))))
(test-success
    "If code ends with \"z\", show \"zed\"."
    (if (= (lcase (right code (len "z"))) (lcase "z")) (then (msgbox "zed"))))
(test-success
    "If cell B2 is empty, show \"blank\"."
    (if (blank? (range "b2")) (then (msgbox "blank"))))
(test-success
    "If cell in column C row k contains \"West\", make cell in column A row k bold."
    (if (positive? (instr 1 (cells k "c") "West" vbtextcompare)) (then (make-bold (cells k "a")))))
(test-success
    "Set v to cell B2 plus 1."
    (set! v (+ (range "b2") 1)))
(test-success
    "Repeat 9 times, stop the loop."
    (dotimes counter 9 (exit-for)))
(test-success
    "While total is greater than 0, stop the loop."
    (while (> total 0) (exit-do)))
(test-success
    "Count k from 1 to 5, stop the loop."
    (for (k 1 5) (exit-for)))
(test-success
    "Set n to length of code."
    (set! n (len code)))
(test-success
    "Set shout to uppercase of name-part."
    (set! shout (ucase name-part)))
(test-success
    "Set m to month of today."
    (set! m (month (date))))
(test-success
    "Set stamp-day to day of now."
    (set! stamp-day (day (now))))
(test-success
    "Set l to length of cell B2."
    (set! l (len (range "b2"))))
(test-success
    "If length of code is greater than 5, show \"long\"."
    (if (> (len code) 5) (then (msgbox "long"))))
(test-success
    "Put now into cell B1."
    (set! (range "b1") (now)))
(test-success
    "Set big to largest of data-cells."
    (set! big (largest-of data-cells)))
(test-success
    "Set small to smallest of data-cells."
    (set! small (smallest-of data-cells)))
(test-success
    "Set s to sum of results."
    (set! s (sum-of results)))
(test-success
    "Set c to count of results."
    (set! c (vlacount results)))
(test-success
    "Create a list called found-items."
    (begin (dim found-items Collection) (obj-set! found-items (new Collection))))
(test-success
    "Append 5 to found-items."
    (. found-items add 5))
(test-success
    "Append counter times 100 to found-items."
    (. found-items add (* counter 100)))
(test-success
    "Set n to count of found-items."
    (set! n (vlacount found-items)))
(test-success
    "For each f in found-items, log f."
    (for-each (f found-items) (debug-print f)))
(test-success
    "Repeat until countdown is 0, decrease countdown by 1."
    (do-until (= countdown 0) (set! countdown (- countdown 1))))
(test-success
    "Repeat until fuel is 5, stop the loop."
    (do-until (= fuel 5) (exit-do)))
(test-success
    "If cell in column number 3 row 2 is 5, log \"hit\"."
    (if (= (cells 2 3) 5) (then (debug-print "hit"))))
(test-success
    "Set x to cell in column number 3 row 2 plus 1."
    (set! x (cells (+ 2 1) 3)))
(test-success
    "If value in column number 3 row 2 is 5, log \"hit\"."
    (if (= (cells 2 3) 5) (then (debug-print "hit"))))
(test-success
    "Set v to value in cell B2."
    (set! v (range "b2")))
(test-success
    "Put 5 into cell Data!B2."
    (set! (range "data!b2") 5))
(test-success
    "Put 5 into cell 'Q1 Data'!B2."
    (set! (range "'Q1 Data'!B2") 5))
(test-success
    "Set x to 15%."
    (set! x (/ 15 100)))
(test-success
    "Set x to 10 percent."
    (set! x (/ 10 100)))
(test-success
    "Grow total by 10%."
    (set! total (* total (+ 1 (/ 10 100)))))
(test-success
    "Shrink total by 25%."
    (set! total (* total (- 1 (/ 25 100)))))
(test-success
    "Set x to first of found-items."
    (set! x (vlafirst found-items)))
(test-success
    "Set x to last of found-items."
    (set! x (vlalast found-items)))
(test-success
    "Set x to item 3 of found-items."
    (set! x (vlaitem found-items 3)))
(test-success
    "Set msg to \"total is \" joined with total."
    (set! msg (& "total is " total)))
(test-success
    "Tidy-up."
    (tidy-up))
(test-success
    "Stamp with row of 2 and value of \"beta\"."
    (stamp :row 2 :value "beta"))
(test-success
    "Fill with width of counter plus 1."
    (fill :width (+ counter 1)))
(english-vla
    "paint cell {r:cell} {e:expr}"
    (set-fill-color (range {r}) (vlacolor {e})))
(test-success
    "Paint cell A1 hot-pink."
    (set-fill-color (range "a1") (vlacolor hot-pink)))
(defmacro
    (datalog-filter-place table shown filtercol op val alias r)
    "write a =DATALOG(...) named-column filter query as a live formula"
    (set-formula r
                 (interpolate "=DATALOG(\"(rule ({alias} X) ({table} ({shown} X) ({filtercol} S)) ({op} S {val})) (query {alias})\", {table})"
                              :alias
                              alias
                              :table
                              table
                              :shown
                              shown
                              :filtercol
                              filtercol
                              :op
                              op
                              :val
                              val)))

(english-vla
    "show every {table:text} {shown:text} whose {filtercol:text} is over {val:expr} as {alias:text} in cell {r:cell}"
    (datalog-filter-place {table} {shown} {filtercol} ">" {val} {alias} (range {r})))
(test-success
    "Show every Staffing name whose salary is over 80000 as rich in cell E2."
    (datalog-filter-place "staffing" "name" "salary" ">" 80000 "rich" (range "e2")))
(english-vla
    "show every {shown:text} in {table:text} with {filtercol:text} over {val:expr} as {alias:text} in cell {r:cell}"
    (datalog-filter-place {table} {shown} {filtercol} ">" {val} {alias} (range {r})))
(test-success
    "Show every Name in Staffing with Salary over 80000 as Rich in cell E2."
    (datalog-filter-place "staffing" "name" "salary" ">" 80000 "rich" (range "e2")))
(defmacro
    (datalog-chain-place table person alias r)
    "write a =DATALOG(...) transitive two-column reachability query as a live formula"
    (set-formula r
                 (interpolate "=DATALOG(\"(rule (vlachain X Y) ({table} X Y)) (rule (vlachain X Y) ({table} X Z) (vlachain Z Y)) (rule ({alias} X) (vlachain X \"\"{person}\"\")) (query {alias})\", {table})"
                              :table
                              table
                              :person
                              person
                              :alias
                              alias)))

(english-vla
    "show everyone who reports to {person:expr} directly or not in {table:text} as {alias:text} in cell {r:cell}"
    (datalog-chain-place {table} {person} {alias} (range {r})))
(test-success
    "Show everyone who reports to \"Alice\" directly or not in Reports as team in cell E2."
    (datalog-chain-place "reports" "Alice" "team" (range "e2")))



