(defmacro
    (table-column v n c)
    "bind a variable to one column's data (header excluded) in an Excel Table"
    (obj-set! v (. (. (activesheet.listobjects n) listcolumns c) databodyrange)))

(english-vla
    "set {v:var} to column {c:text} of table {n:text}"
    (table-column {v} {n} {c}))
(test-success
    "Set qty-values to column Qty of table Sales."
    (table-column qty-values "sales" "qty"))
(defmacro
    (tablespec-row name doc body pattern call testsentence testcall)
    "emit one single-parameter defmacro/english-vla/test-success triple - table-property-family's own arity, BODY supplied whole instead of derived from a property/value pair"
    (begin (defmacro
               (name n)
               doc
               body)

           (english-vla
               pattern
               call)
           (test-success
               testsentence
               testcall)))

(defmacro
    (tablespec spec)
    "walk a quoted list of (name doc body pattern call testsentence testcall) rows, calling tablespec-row once per row - see this file's own TABLESPEC comment above for the depth ceiling this inherits"
    (quote-if (null? spec)
              (begin)
              (begin (tablespec-row
                         (car (car spec))
                         (cadr (car spec))
                         (car (cddr (car spec)))
                         (cadr (cddr (car spec)))
                         (caddr (cddr (car spec)))
                         (cadr (cddr (cddr (car spec))))
                         (caddr (cddr (cddr (car spec)))))
                     (tablespec (cdr spec)))))

(defmacro
    (pivot-create r b n)
    "create a pivot table from a range at a destination cell"
    (vlapivotcreate r b n))

(english-vla
