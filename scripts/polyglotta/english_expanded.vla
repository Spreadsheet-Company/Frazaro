    "Make a pivot table from A1:C10 at F1 called SalesPivot."
    (pivot-create (range "a1:c10") (range "f1") "salespivot"))
(defmacro
    (pivot-rows n f)
    "add field names to a pivot table's row area"
    (vlapivotsetorientation n f "row"))

(defmacro
    (pivot-columns n f)
    "add field names to a pivot table's column area"
    (vlapivotsetorientation n f "column"))

(defmacro
    (pivot-filters n f)
    "add field names to a pivot table's filter (page) area"
    (vlapivotsetorientation n f "filter"))

(english-vla
    "add {d:rows|columns|filters} of {f:text-list} to pivot {n:text}"
    (pivot-{d} {n} {f}))
(test-success
    "Add rows of Region, Product to pivot SalesPivot."
    (pivot-rows "salespivot" (array "region" "product")))
(test-success
    "Add columns of Segment to pivot SalesPivot."
    (pivot-columns "salespivot" (array "segment")))
(test-success
    "Add filters of Region, Segment to pivot SalesPivot."
    (pivot-filters "salespivot" (array "region" "segment")))
(defmacro
    (pivot-remove-field n f)
    "remove field names from a pivot table's layout entirely"
    (vlapivotsetorientation n f "hidden"))

(english-vla
    "remove {f:text-list} from pivot {n:text}"
    (pivot-remove-field {n} {f}))
(test-success
    "Remove Product from pivot SalesPivot."
    (pivot-remove-field "salespivot" (array "product")))
(defmacro
    (pivot-full r destcell n rowfields colfields valfields)
    "the composite pivot sentence - create, then set rows/columns, then add value fields (sum-only)"
    (begin (pivot-create r destcell n)
           (pivot-rows n rowfields)
           (pivot-columns n colfields)
           (vlapivotaddvalues n valfields "sum")))

(english-vla
    "make a pivot table from {r:range} at {b:cell} called {n:text} with rows of {a:text-list} and columns of {c:text-list} and values of {v:text-list}"
    (pivot-full (range {r}) (range {b}) {n} {a} {c} {v}))
(test-success
    "Make a pivot table from A1:C10 at F1 called SalesPivot with rows of Region, Product and columns of Segment and values of Revenue."
    (pivot-full (range "a1:c10")
                (range "f1")
                "salespivot"
                (array "region" "product")
                (array "segment")
                (array "revenue")))
