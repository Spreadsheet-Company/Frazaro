(defmacro
    (sort-with-header r c order)
    "sort a range by one of its columns, keeping the range's first row in place as its header"
    (. r sort :key1 (. r columns (vlacolumninrange r c)) :order1 order :header xlyes))

(defmacro
    (sort-without-header r c order)
    "sort every row of a range by one of its columns - no header row held back"
    (. r sort :key1 (. r columns (vlacolumninrange r c)) :order1 order :header xlno))

(defmacro
    (sort-two-with-header r c order e order2)
    "sort a range by one column and then another, keeping the range's first row in place as its header"
    (. r
       sort
       :key1
       (. r columns (vlacolumninrange r c))
       :order1
       order
       :key2
       (. r columns (vlacolumninrange r e))
       :order2
       order2
       :header
       xlyes))

(defmacro
    (sort-two-without-header r c order e order2)
    "sort every row of a range by one column and then another - no header row held back"
    (. r
       sort
       :key1
       (. r columns (vlacolumninrange r c))
       :order1
       order
       :key2
       (. r columns (vlacolumninrange r e))
       :order2
       order2
       :header
       xlno))

(english-vla
    "sort [range] {r:range} by column {c:column} {h:with|without} header [row]"
    (sort-{h}-header (range {r}) {c} xlascending))
(test-success
    "Sort range A1:C50 by column B with a header row."
    (sort-with-header (range "a1:c50") "b" xlascending))
(test-success
    "Sort A2:C50 by column B without a header row."
    (sort-without-header (range "a2:c50") "b" xlascending))
(test-success
    "Sort range A1:C50 by column C with a header."
    (sort-with-header (range "a1:c50") "c" xlascending))
(test-fail
    "Sort range A1:C50 by column B."
    "one of 'with'/'without'")
(english-vla
    "sort [range] {r:range} by column {c:column} {d:ascending|descending} {h:with|without} header [row]"
    (sort-{h}-header (range {r}) {c} xl{d}))
(test-success
    "Sort range A1:C50 by column B descending with a header row."
    (sort-with-header (range "a1:c50") "b" xldescending))
(test-success
    "Sort range A2:C50 by column B ascending without a header row."
    (sort-without-header (range "a2:c50") "b" xlascending))
(english-vla
    "sort [range] {r:range} by column {c:column} then [by] column {e:column} {h:with|without} header [row]"
    (sort-two-{h}-header (range {r}) {c} xlascending {e} xlascending))
(test-success
    "Sort range A1:C50 by column B then by column C with a header row."
    (sort-two-with-header (range "a1:c50") "b" xlascending "c" xlascending))
(test-success
    "Sort range A2:C50 by column B then column C without a header row."
    (sort-two-without-header (range "a2:c50") "b" xlascending "c" xlascending))
(english-vla
    "sort [range] {r:range} by column {c:column} {d:ascending|descending} then [by] column {e:column} {f:ascending|descending} {h:with|without} header [row]"
    (sort-two-{h}-header (range {r}) {c} xl{d} {e} xl{f}))
