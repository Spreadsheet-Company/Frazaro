; SPDX-License-Identifier: MPL-2.0
; pirate.vla - a demo dialect, riding the same macros as english-vla.
; Every rule below targets a macro already defined in scripts/english.vla -
; this is what <lingua>-vla being per-rule (not per-file) buys for free:
; no new defmacros, no new runtime helpers, just a different surface text
; over the same templates. Load english.vla FIRST so these macros exist,
; then load this file.
;
; {d:bold|italic}, {d:red|yellow}, {d:hide|unhide} still have to be the
; literal English words - they bind straight into the macro name
; (make-{d}, vb{d}, {d}-column) - so the piracy lives in the carrier
; phrase around them, not in the bound word itself.
;
; Unverified against the live engine (blind-write discipline) - Check
; Sentences / Reload Vocabulary is the real test.

(pirate-vla
    "chart the course {f:text} onto the cell {r:cell}, arr"
    (set-formula (range {r}) {f}))
(test-success
    "Chart the course \"=B2*2\" onto the cell B3, arr."
    (set-formula (range "b3") "=B2*2"))

(pirate-vla
    "stow {e:expr} in the cell {r:cell}, arr"
    (set! (range {r}) {e}))
(test-success
    "Stow 5 in the cell B2, arr."
    (set! (range "b2") 5))

(pirate-vla
    "mark today upon the cell {r:cell}, savvy"
    (set! (range {r}) (date)))
(test-success
    "Mark today upon the cell D1, savvy."
    (set! (range "d1") (date)))

(pirate-vla
    "brand cell {r:cell} {d:bold|italic}, arr"
    (make-{d} (range {r})))
(test-success
    "Brand cell A1 bold, arr."
    (make-bold (range "a1")))

(pirate-vla
    "paint cell {r:cell} {d:red|yellow} like blood 'n gold"
    (set-fill-color (range {r}) vb{d}))
(test-success
    "Paint cell C4 red like blood 'n gold."
    (set-fill-color (range "c4") vbred))

(pirate-vla
    "keelhaul row {n:expr}"
    (delete-row {n}))
(test-success
    "Keelhaul row 5."
    (delete-row 5))

(pirate-vla
    "maroon column {c:column}"
    (delete-column {c}))
(test-success
    "Maroon column C."
    (delete-column "c"))

(pirate-vla
    "{d:hide|unhide} column {c:column} from the crew"
    ({d}-column {c}))
(test-success
    "Hide column C from the crew."
    (hide-column "c"))
(test-success
    "Unhide column C from the crew."
    (unhide-column "c"))

(pirate-vla
    "swab the cell|range {r:range} clean"
    (clear-contents (range {r})))
(test-success
    "Swab the range A1:C10 clean."
    (clear-contents (range "a1:c10")))

(pirate-vla
    "lash a plank border round range {r:range}"
    (add-border (range {r})))
(test-success
    "Lash a plank border round range \"A1:C10\"."
    (add-border (range "A1:C10")))

(pirate-vla
    "sort the booty in range {r:range} by column {k:cell}, biggest treasure first"
    (sort-range-by (range {r}) (range {k}) xldescending))
(test-success
    "Sort the booty in range \"A1:C50\" by column B1, biggest treasure first."
    (sort-range-by (range "A1:C50") (range "b1") xldescending))

(pirate-vla
    "set sail fer sheet {s:sheet}"
    (begin (vlaensuresheet {s}) (activate-sheet {s})))
(test-success
    "Set sail fer sheet Results."
    (begin (vlaensuresheet "results") (activate-sheet "results")))

(pirate-vla
    "chart a new island called {s:sheet}"
    (add-sheet-called {s}))
(test-success
    "Chart a new island called \"Treasure\"."
    (add-sheet-called "Treasure"))

(pirate-vla
    "hoist a button called {c:text} at cell {r:cell}"
    (make-button {c} (range {r})))
(test-success
    "Hoist a button called \"Recalculate Totals\" at cell D3."
    (make-button "Recalculate Totals" (range "d3")))

(pirate-vla
    "cry {e:expr} from the crow's nest"
    (set-status-bar {e}))
(test-success
    "Cry \"land ho\" from the crow's nest."
    (set-status-bar "land ho"))

(pirate-vla
    "silence the crow's nest"
    (set-status-bar false))
(test-success
    "Silence the crow's nest."
    (set-status-bar false))

(pirate-vla
    "wait {n:expr} seconds fer the tide to turn"
    (wait-seconds {n}))
(test-success
    "Wait 2 seconds fer the tide to turn."
    (wait-seconds 2))

(pirate-vla
    "abandon ship and close this logbook"
    (close-workbook))
(test-success
    "Abandon ship and close this logbook."
    (close-workbook))

(pirate-vla
    "send a message in a bottle to {who:expr} titled {s:expr} sayin' {m:expr}"
    (vlasendmail {who} {s} {m}))
(test-success
    "Send a message in a bottle to \"boss@co.com\" titled \"Report\" sayin' \"Attached.\"."
    (vlasendmail "boss@co.com" "Report" "Attached."))



