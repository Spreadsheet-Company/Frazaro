(sheet "Plan" visible)
(cell "Plan" "A1" "Month")
(cell "Plan" "B1" "Units")
(cell "Plan" "C1" "Price")
(cell "Plan" "D1" "Revenue")
(cell "Plan" "A2" "Jan")
(cell "Plan" "B2" 120)
(cell "Plan" "C2" 40)
(cell "Plan" "D2" 4800)
(formula "Plan" "D2" "=B2*C2")
(refers "Plan!D2" "Plan!B2")
(refers "Plan!D2" "Plan!C2")
(cell "Plan" "A3" "Feb")
(cell "Plan" "B3" 135)
(cell "Plan" "C3" 40)
(cell "Plan" "D3" 5400)
(formula "Plan" "D3" "=B3*C3")
(refers "Plan!D3" "Plan!B3")
(refers "Plan!D3" "Plan!C3")
(cell "Plan" "A4" "Mar")
(cell "Plan" "B4" 150)
(cell "Plan" "C4" 40)
(cell "Plan" "D4" 6000)
(formula "Plan" "D4" "=B4*C4")
(refers "Plan!D4" "Plan!B4")
(refers "Plan!D4" "Plan!C4")
(cell "Plan" "A5" "Apr")
(cell "Plan" "B5" 160)
(cell "Plan" "C5" 40)
(cell "Plan" "D5" 6400)
(formula "Plan" "D5" "=B5*C5")
(refers "Plan!D5" "Plan!B5")
(refers "Plan!D5" "Plan!C5")
(cell "Plan" "A6" "May")
(cell "Plan" "B6" 155)
(cell "Plan" "C6" 40)
(cell "Plan" "D6" 6200)
(formula "Plan" "D6" "=B6*C6")
(refers "Plan!D6" "Plan!B6")
(refers "Plan!D6" "Plan!C6")
(cell "Plan" "A7" "Jun")
(cell "Plan" "B7" 170)
(cell "Plan" "C7" 40)
(cell "Plan" "D7" 6800)
(formula "Plan" "D7" "=B7*C7")
(refers "Plan!D7" "Plan!B7")
(refers "Plan!D7" "Plan!C7")
(cell "Plan" "A8" "Total")
(cell "Plan" "B8" 890)
(formula "Plan" "B8" "=SUM(B2:B7)")
(refers "Plan!B8" "Plan!B2:B7")
(cell "Plan" "D8" 35600)
(formula "Plan" "D8" "=SUM(D2:D7)")
(refers "Plan!D8" "Plan!D2:D7")
