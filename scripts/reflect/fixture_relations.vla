(sheet "Model" visible)
(sheet "Data" visible)
(sheet "Scratch" hidden)
(sheet "Secret" very-hidden)
(sheet "Q1 Data" visible)
(sheet "It's" visible)
(name "Broken" "Model!#REF!")
(name "HiddenName" "3")
(name "Model!Local" "Model!$B$2")
(name "Range1" "Data!$A$2:$B$4")
(name "Rate" "0.2")
(table "Sales" "Data" "A1:B4")
(cell "Model" "A1" "Revenue")
(cell "Model" "B1" 1200)
(cell "Model" "C1" 2400)
(formula "Model" "C1" "=B1*2")
(cell "Model" "D1" 2480)
(formula "Model" "D1" "=SUM(B:B)")
(cell "Model" "E1" 60)
(formula "Model" "E1" "=SUM(Sales[Amount])")
(cell "Model" "F1" 1)
(formula "Model" "F1" "=SEQUENCE(2)")
(cell "Model" "G1" 3)
(formula "Model" "G1" "=HiddenName")
(cell "Model" "A2" "Cost")
(cell "Model" "B2" 800)
(cell "Model" "C2" 1600)
(formula "Model" "C2" "=B2*2")
(cell "Model" "D2" 1200)
(formula "Model" "D2" "=INDIRECT(\"B1\")")
(cell "Model" "E2" 99)
(formula "Model" "E2" "=[1]Sheet1!A1")
(cell "Model" "F2" 2)
(cell "Model" "G2" 800)
(formula "Model" "G2" "=Local")
(cell "Model" "H2" "Revenue!")
(formula "Model" "H2" "=A1&\"!\"")
(cell "Model" "A3" "Margin")
(cell "Model" "B3" 400)
(formula "Model" "B3" "=B1-B2")
(cell "Model" "C3" 800)
(formula "Model" "C3" "=B3*2")
(cell "Model" "D3" 800)
(formula "Model" "D3" "=OFFSET(B1,1,0)")
(cell "Model" "E3" 2400)
(formula "Model" "E3" "=B1:B2*2")
(cell "Model" "A4" "Rate applies")
(cell "Model" "B4" 80)
(formula "Model" "B4" "=B3*Rate")
(cell "Model" "D4" 1205)
(formula "Model" "D4" "=SUM(Model:Scratch!B1)")
(cell "Model" "E4" 1600)
(cell "Model" "A5" true)
(cell "Model" "D5" 17)
(formula "Model" "D5" "='Q1 Data'!B2+'It''s'!A1")
(cell "Model" "E5" (error "#DIV/0!"))
(formula "Model" "E5" "=1/0")
(cell "Model" "A6" 45930)
(cell "Data" "A1" "Item")
(cell "Data" "B1" "Amount")
(cell "Data" "A2" "pens")
(cell "Data" "B2" 10)
(cell "Data" "A3" "ink")
(cell "Data" "B3" 20)
(cell "Data" "A4" "paper")
(cell "Data" "B4" 30)
(cell "Scratch" "B1" 5)
(cell "Secret" "A1" "do not show")
(cell "Q1 Data" "B2" 10)
(cell "It's" "A1" 7)
