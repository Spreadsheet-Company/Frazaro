(sheet "Model" visible)
(sheet "Data" visible)
(sheet "Scratch" hidden)
(sheet "Secret" hidden)
(sheet "Q1 Data" visible)
(sheet "It's" visible)
(sheet "Review" visible)
(name "HiddenName" "3")
(name "Local" "Model!$B$2")
(name "Range1" "Data!$A$2:$B$4")
(name "Rate" "0.2")
(table "Sales" "Data" "A1:B4")
(gridlines "Model" on)
(format 0 none general nowrap)
(format 2 none "yyyy-mm-dd" nowrap)
(cell "Model" "A1" "Revenue")
(cell "Model" "B1" 1200)
(formula "Model" "C1" "=B1*2")
(value "Model" "C1" 2400)
(refers "Model!C1" "Model!B1")
(formula "Model" "D1" "=SUM(B:B)")
(value "Model" "D1" 2480)
(refers "Model!D1" "Model!B:B")
(formula "Model" "E1" "=SUM(Data!B2:B4)")
(value "Model" "E1" 60)
(refers "Model!E1" "Data!B2:B4")
(formula "Model" "F1" "=SEQUENCE(2)")
(value "Model" "F1" 1)
(formula "Model" "G1" "=HiddenName")
(value "Model" "G1" 3)
(refers "Model!G1" "HiddenName")
(cell "Model" "A2" "Cost")
(cell "Model" "B2" 800)
(formula "Model" "C2" "=B2*2")
(value "Model" "C2" 1600)
(refers "Model!C2" "Model!B2")
(formula "Model" "D2" "=INDIRECT(\"B1\")")
(value "Model" "D2" 1200)
(refers "Model!D2" (unreadable "INDIRECT"))
(formula "Model" "E2" "=[Rates.xlsx]Sheet1!A1")
(value "Model" "E2" 99)
(refers "Model!E2" "[Rates.xlsx]Sheet1!A1")
(cell "Model" "F2" 2)
(formula "Model" "G2" "=Local")
(value "Model" "G2" 800)
(refers "Model!G2" "Local")
(formula "Model" "H2" "=A1&\"!\"")
(value "Model" "H2" "Revenue!")
(refers "Model!H2" "Model!A1")
(cell "Model" "A3" "Margin")
(formula "Model" "B3" "=B1-B2")
(value "Model" "B3" 400)
(refers "Model!B3" "Model!B1")
(refers "Model!B3" "Model!B2")
(formula "Model" "C3" "=B3*2")
(value "Model" "C3" 800)
(refers "Model!C3" "Model!B3")
(formula "Model" "D3" "=OFFSET(B1,1,0)")
(value "Model" "D3" 800)
(refers "Model!D3" "Model!B1")
(refers "Model!D3" (unreadable "OFFSET"))
(formula "Model" "E3" "=B1:B2*2")
(value "Model" "E3" 2400)
(refers "Model!E3" "Model!B1:B2")
(cell "Model" "A4" "Rate applies")
(formula "Model" "B4" "=B3*Rate")
(value "Model" "B4" 80)
(refers "Model!B4" "Model!B3")
(refers "Model!B4" "Rate")
(formula "Model" "D4" "=SUM(Model:Scratch!B1)")
(value "Model" "D4" 1205)
(refers "Model!D4" "Model:Scratch!B1")
(cell "Model" "E4" 1600)
(cell "Model" "A5" true)
(formula "Model" "D5" "='Q1 Data'!B2+'It''s'!A1")
(value "Model" "D5" 17)
(refers "Model!D5" "'It''s'!A1")
(refers "Model!D5" "'Q1 Data'!B2")
(formula "Model" "E5" "=1/0")
(value "Model" "E5" (error "#DIV/0!"))
(cell "Model" "A6" 45930)
(style "Model" "A6" 2)
(gridlines "Data" on)
(format 0 none general nowrap)
(cell "Data" "A1" "Item")
(cell "Data" "B1" "Amount")
(cell "Data" "A2" "pens")
(cell "Data" "B2" 10)
(cell "Data" "A3" "ink")
(cell "Data" "B3" 20)
(cell "Data" "A4" "paper")
(cell "Data" "B4" 30)
(gridlines "Scratch" on)
(format 0 none general nowrap)
(cell "Scratch" "B1" 5)
(gridlines "Secret" on)
(format 0 none general nowrap)
(cell "Secret" "A1" "do not show")
(gridlines "Q1 Data" on)
(format 0 none general nowrap)
(cell "Q1 Data" "B2" 10)
(gridlines "It's" on)
(format 0 none general nowrap)
(cell "It's" "A1" 7)
(gridlines "Review" on)
(format 0 none general nowrap)
(cell "Review" "A1" 10)
(formula "Review" "B1" "=A1*2")
(value "Review" "B1" 20)
(refers "Review!B1" "Review!A1")
(formula "Review" "C1" "=A1+1")
(value "Review" "C1" 11)
(refers "Review!C1" "Review!A1")
(formula "Review" "D1" "=Z9")
(value "Review" "D1" 0)
(refers "Review!D1" "Review!Z9")
(cell "Review" "A2" 20)
(formula "Review" "B2" "=A2*2")
(value "Review" "B2" 40)
(refers "Review!B2" "Review!A2")
(formula "Review" "C2" "=A2+1")
(value "Review" "C2" 21)
(refers "Review!C2" "Review!A2")
(formula "Review" "D2" "=Model!H1")
(value "Review" "D2" 0)
(refers "Review!D2" "Model!H1")
(cell "Review" "A3" 30)
(cell "Review" "B3" 61)
(formula "Review" "C3" "=A3+2")
(value "Review" "C3" 32)
(refers "Review!C3" "Review!A3")
(cell "Review" "A4" 40)
(formula "Review" "B4" "=A4*2")
(value "Review" "B4" 80)
(refers "Review!B4" "Review!A4")
(formula "Review" "C4" "=A4+1")
(value "Review" "C4" 41)
(refers "Review!C4" "Review!A4")
(cell "Review" "A5" 50)
(formula "Review" "B5" "=A5*2")
(value "Review" "B5" 100)
(refers "Review!B5" "Review!A5")
(formula "Review" "C5" "=A5+1")
(value "Review" "C5" 51)
(refers "Review!C5" "Review!A5")
