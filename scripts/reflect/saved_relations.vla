(cell "Frazaro" "B1" "# The build golden's fixture (PORT.7): a small workbook, from sentences.")
(cell "Frazaro" "C1" "OK")
(cell "Frazaro" "B2" "# Column B of the Frazaro sheet holds these lines exactly as written.")
(cell "Frazaro" "C2" "OK")
(cell "Frazaro" "B4" "Put 5 into cell B2.")
(cell "Frazaro" "C4" "OK")
(cell "Frazaro" "B5" "Put formula \"=B2*2\" into cell B3.")
(cell "Frazaro" "C5" "OK")
(cell "Frazaro" "B6" "Put formula \"=B2+B3\" into rows 2 to 4 of column C.")
(cell "Frazaro" "C6" "OK")
(cell "Frazaro" "B7" "Put formula \"=IFS(B2>3,\"\"big\"\",TRUE,\"\"small\"\")\" into cell D2.")
(cell "Frazaro" "C7" "OK")
(cell "Frazaro" "B9" "Work on sheet Data.")
(cell "Frazaro" "C9" "OK")
(cell "Frazaro" "B10" "Put \"west\" into cell A1.")
(cell "Frazaro" "C10" "OK")
(cell "Frazaro" "B11" "Put 7 into cell B1 of sheet Output.")
(cell "Frazaro" "C11" "OK")
(cell "Output" "B1" 7)
(cell "Output" "B2" 5)
(cell "Output" "C2" 15)
(formula "Output" "C2" "=B2+B3")
(refers "Output!C2" "Output!B2")
(refers "Output!C2" "Output!B3")
(cell "Output" "D2" "big")
(formula "Output" "D2" "=IFS(B2>3,\"big\",TRUE,\"small\")")
(refers "Output!D2" "Output!B2")
(cell "Output" "B3" 10)
(formula "Output" "B3" "=B2*2")
(refers "Output!B3" "Output!B2")
