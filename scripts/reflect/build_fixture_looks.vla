(cell "Frazaro" "C1" "OK")
(style "Frazaro" "C1" 3)
(cell "Frazaro" "B2" "# Column B of the Frazaro sheet holds these lines exactly as written.")
(style "Frazaro" "B2" 1)
(cell "Frazaro" "C2" "OK")
(style "Frazaro" "C2" 3)
(cell "Frazaro" "B4" "Put 5 into cell B2.")
(style "Frazaro" "B4" 1)
(cell "Frazaro" "C4" "OK")
(style "Frazaro" "C4" 3)
(cell "Frazaro" "B5" "Put formula \"=B2*2\" into cell B3.")
(style "Frazaro" "B5" 1)
(cell "Frazaro" "C5" "OK")
(style "Frazaro" "C5" 3)
(cell "Frazaro" "B6" "Put formula \"=B2+B3\" into rows 2 to 4 of column C.")
(style "Frazaro" "B6" 1)
(cell "Frazaro" "C6" "OK")
(style "Frazaro" "C6" 3)
(cell "Frazaro" "B7" "Put formula \"=IFS(B2>3,\"\"big\"\",TRUE,\"\"small\"\")\" into cell D2.")
(style "Frazaro" "B7" 1)
(cell "Frazaro" "C7" "OK")
(style "Frazaro" "C7" 3)
(cell "Frazaro" "B9" "Work on sheet Data.")
(style "Frazaro" "B9" 1)
(cell "Frazaro" "C9" "OK")
(style "Frazaro" "C9" 3)
(cell "Frazaro" "B10" "Put \"west\" into cell A1.")
(style "Frazaro" "B10" 1)
(cell "Frazaro" "C10" "OK")
(style "Frazaro" "C10" 3)
(cell "Frazaro" "B11" "Put 7 into cell B1 of sheet Output.")
(style "Frazaro" "B11" 1)
(cell "Frazaro" "C11" "OK")
(style "Frazaro" "C11" 3)
