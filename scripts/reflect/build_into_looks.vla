(sheet "Model" visible)
(sheet "Notes" visible)
(sheet "Frazaro" visible)
(sheet "Output" visible)
(sheet "checks" visible)
(name "Frazaro.Build" "\"Frazaro 0.12.0; into sha256:79DAD00796744AEA14D841A3B0395670AB87161A447A084EAE7CA20708208C85 with 2 cell formats and metadata 1; sentences sha256:14D649F19C7F73A7F4DC6F863744AAB6E09E3DC56DA6CEC91DB9E7D52CCFE451 over 301 non-whitespace bytes; prelude sha256:887F55C46AA71563EE5DE0F74E3D4DB1C0022986248AD1FBF8A7A63711AC508C over 27033 non-whitespace bytes; phrasebook 1 sha256:5E5FF4121AA83D783E926C1A78B8E8C7C45BFE1E1184340F8D93A0285DDCB949 over 167902 non-whitespace bytes\"")
(name "Rate" "0.2")
(gridlines "Model" on)
(column "Model" "A" 12 shown none)
(format 0 none general nowrap)
(format 1 none general nowrap (font bold))
(cell "Model" "A1" "Revenue")
(style "Model" "A1" 1)
(cell "Model" "B1" 1200)
(cell "Model" "A2" "Cost")
(style "Model" "A2" 1)
(cell "Model" "B2" 800)
(cell "Model" "A3" "Margin")
(style "Model" "A3" 1)
(formula "Model" "B3" "=B1-B2")
(value "Model" "B3" 400)
(refers "Model!B3" "Model!B1")
(refers "Model!B3" "Model!B2")
(gridlines "Notes" on)
(format 0 none general nowrap)
(cell "Notes" "A1" "Q3 close")
(gridlines "Frazaro" off)
(column "Frazaro" "B" 72 shown 2)
(column "Frazaro" "C" 60 shown 3)
(format 0 none general nowrap)
(format 2 "F7F4FC" text nowrap)
(format 3 "F2F2F2" general wrap)
(format 4 "DDEBDD" general wrap)
(cell "Frazaro" "B1" "# Built into model.xlsx (PORT.7, slice 7d): the model's own sheets stay as they are.")
(style "Frazaro" "B1" 2)
(cell "Frazaro" "C1" "OK")
(style "Frazaro" "C1" 4)
(cell "Frazaro" "B2" "# Output and Checks are new sheets; their formulas read the model's Model sheet and its name Rate.")
(style "Frazaro" "B2" 2)
(cell "Frazaro" "C2" "OK")
(style "Frazaro" "C2" 4)
(cell "Frazaro" "B4" "Put \"margin after rate\" into cell A1.")
(style "Frazaro" "B4" 2)
(cell "Frazaro" "C4" "OK")
(style "Frazaro" "C4" 4)
(cell "Frazaro" "B5" "Put formula \"=Model!B3*Rate\" into cell B1.")
(style "Frazaro" "B5" 2)
(cell "Frazaro" "C5" "OK")
(style "Frazaro" "C5" 4)
(cell "Frazaro" "B7" "Work on sheet Checks.")
(style "Frazaro" "B7" 2)
(cell "Frazaro" "C7" "OK")
(style "Frazaro" "C7" 4)
(cell "Frazaro" "B8" "Put formula \"=IFS(Model!B3>0,\"\"profit\"\",TRUE,\"\"loss\"\")\" into cell A1.")
(style "Frazaro" "B8" 2)
(cell "Frazaro" "C8" "OK")
(style "Frazaro" "C8" 4)
(gridlines "Output" on)
(format 0 none general nowrap)
(cell "Output" "A1" "margin after rate")
(formula "Output" "B1" "=Model!B3*Rate")
(refers "Output!B1" "Model!B3")
(refers "Output!B1" "Rate")
(gridlines "checks" on)
(format 0 none general nowrap)
(formula "checks" "A1" "=IFS(Model!B3>0,\"profit\",TRUE,\"loss\")")
(refers "checks!A1" "Model!B3")
