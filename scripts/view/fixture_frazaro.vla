(sheet "Frazaro" visible)
(sheet "Output" visible)
(sheet "data" visible)
(window "Frazaro" "B1:C11")
(extent "Frazaro" "B1:C11")
(gridlines "Frazaro" off)
(column "Frazaro" "B" 72 shown 1)
(column "Frazaro" "C" 60 shown 2)
(format 0 none general nowrap)
(format 1 "F7F4FC" text nowrap)
(format 2 "F2F2F2" general wrap)
(format 3 "DDEBDD" general wrap)
(cell "Frazaro" "B1" "# The build golden's fixture (PORT.7): a small workbook, from sentences.")
(style "Frazaro" "B1" 1)
(sentence "Frazaro" "B1" 1)
(cell "Frazaro" "C1" "OK")
(style "Frazaro" "C1" 3)
(sentence "Frazaro" "C1" 1)
(cell "Frazaro" "B2" "# Column B of the Frazaro sheet holds these lines exactly as written.")
(style "Frazaro" "B2" 1)
(sentence "Frazaro" "B2" 2)
(cell "Frazaro" "C2" "OK")
(style "Frazaro" "C2" 3)
(sentence "Frazaro" "C2" 2)
(cell "Frazaro" "B4" "Put 5 into cell B2.")
(style "Frazaro" "B4" 1)
(sentence "Frazaro" "B4" 4)
(cell "Frazaro" "C4" "OK")
(style "Frazaro" "C4" 3)
(sentence "Frazaro" "C4" 4)
(cell "Frazaro" "B5" "Put formula \"=B2*2\" into cell B3.")
(style "Frazaro" "B5" 1)
(sentence "Frazaro" "B5" 5)
(cell "Frazaro" "C5" "OK")
(style "Frazaro" "C5" 3)
(sentence "Frazaro" "C5" 5)
(cell "Frazaro" "B6" "Put formula \"=B2+B3\" into rows 2 to 4 of column C.")
(style "Frazaro" "B6" 1)
(sentence "Frazaro" "B6" 6)
(cell "Frazaro" "C6" "OK")
(style "Frazaro" "C6" 3)
(sentence "Frazaro" "C6" 6)
(cell "Frazaro" "B7" "Put formula \"=IFS(B2>3,\"\"big\"\",TRUE,\"\"small\"\")\" into cell D2.")
(style "Frazaro" "B7" 1)
(sentence "Frazaro" "B7" 7)
(cell "Frazaro" "C7" "OK")
(style "Frazaro" "C7" 3)
(sentence "Frazaro" "C7" 7)
(cell "Frazaro" "B9" "Work on sheet Data.")
(style "Frazaro" "B9" 1)
(sentence "Frazaro" "B9" 9)
(cell "Frazaro" "C9" "OK")
(style "Frazaro" "C9" 3)
(sentence "Frazaro" "C9" 9)
(cell "Frazaro" "B10" "Put \"west\" into cell A1.")
(style "Frazaro" "B10" 1)
(sentence "Frazaro" "B10" 10)
(cell "Frazaro" "C10" "OK")
(style "Frazaro" "C10" 3)
(sentence "Frazaro" "C10" 10)
(cell "Frazaro" "B11" "Put 7 into cell B1 of sheet Output.")
(style "Frazaro" "B11" 1)
(sentence "Frazaro" "B11" 11)
(cell "Frazaro" "C11" "OK")
(style "Frazaro" "C11" 3)
(sentence "Frazaro" "C11" 11)
