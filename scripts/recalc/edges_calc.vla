(calc "Output" "C1" "=10^14&\"\"" "100000000000000" "100000000000000" agree)
(calc "Output" "C2" "=10^15&\"\"" "1E+15" "1E+15" agree)
(calc "Output" "C3" "=10^15-1&\"\"" "999999999999999" "999999999999999" agree)
(calc "Output" "C4" "=2^57&\"\"" "1.44115188075856E+17" "1.44115188075856E+17" agree)
(calc "Output" "C5" "=10^-14&\"\"" "0.00000000000001" "0.00000000000001" agree)
(calc "Output" "C6" "=10^-15&\"\"" "1E-15" "1E-15" agree)
(calc "Output" "C7" "=1/3*10^-5&\"\"" "0.00000333333333333333" "0.00000333333333333333" agree)
(calc "Output" "C8" "=1/3*10^-10&\"\"" "0.0000000000333333333333333" "0.0000000000333333333333333" agree)
(calc "Output" "C9" "=-0.0000001&\"\"" "-0.0000001" "-0.0000001" agree)
(calc "Output" "C10" "=1/7*10^6&\"\"" "142857.142857143" "142857.142857143" agree)
(calc "Output" "C11" "=2^0.5&\"\"" "1.4142135623731" "1.4142135623731" agree)
(calc "Output" "C12" "=NOT(A1)" false false agree)
(calc "Output" "C13" "=IFS(A1,1,TRUE,2)" 1 1 agree)
(calc "Output" "C14" "=IF(A2,1,2)" 2 2 agree)
(calc "Output" "C15" "=IF(A3,1,2)" (error "#VALUE!") (error "#VALUE!") agree)
(calc "Output" "C16" "=OR(A1)" (error "#VALUE!") (error "#VALUE!") agree)
