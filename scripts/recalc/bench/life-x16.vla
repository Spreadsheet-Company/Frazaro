(cell "Camera" "A1" "row")
(cell "Camera" "B1" 1)
(cell "Camera" "A2" "column")
(cell "Camera" "B2" 1)
(formula "Screen" "B2:AWE799" "=IF(Clock!$B$1=1,IF(MOD(MOD(MOD(Clock!$B$3*1103515+ROW()*1597334+COLUMN()*1830421+12345,67108859)*MOD(Clock!$B$3*2012345+ROW()*1209487+COLUMN()*1949213+54321,67108859),67108859)*MOD(MOD(Clock!$B$3*1103515+ROW()*1597334+COLUMN()*1830421+12345,67108859)*MOD(Clock!$B$3*2012345+ROW()*1209487+COLUMN()*1949213+54321,67108859),67108859),67108859)<25165822,1,0),IF(OR(SUM(Screen.last!A1:C3)-Screen.last!B2=3,AND(Screen.last!B2=1,SUM(Screen.last!A1:C3)-Screen.last!B2=2)),1,0))")
; The engine's own sheets, as Alonzo's Cartridge::load writes them into its draft (make_own_sheets), the frame 1 and the seed 1:
(cell "Clock" "A1" "frame")
(cell "Clock" "B1" 1)
(cell "Clock" "A2" "rate")
(cell "Clock" "B2" 30)
(cell "Clock" "A3" "seed")
