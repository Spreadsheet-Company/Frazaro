(formula "Decays" "A1:SR512" "=IF(AND(FirstRow!$B1>0,ABS(COLUMN()-FirstRow!$B1)<=1),0,IF(MOD(MOD(MOD(Clock!$B$3*1103515+ROW()*1597334+COLUMN()*1830421+Lab!$B$2*7919+3440100,67108859)*MOD(Clock!$B$3*2012345+ROW()*1209487+COLUMN()*1949213+Lab!$B$2*104729+3213021,67108859),67108859)*MOD(MOD(Clock!$B$3*1103515+ROW()*1597334+COLUMN()*1830421+Lab!$B$2*7919+3440100,67108859)*MOD(Clock!$B$3*2012345+ROW()*1209487+COLUMN()*1949213+Lab!$B$2*104729+3213021,67108859),67108859),67108859)<Constants!$B$1*67108859,1,0))")
(formula "Readings" "A1" "=IF(Decays!A1=1,10000000000,10000+SUM(Decays!A1:B2))")
