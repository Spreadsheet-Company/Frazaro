(cell "Observer" "A1" "Superposition")
(cell "Observer" "A3" "world")
(cell "Observer" "A4" "sites observed")
(cell "Observer" "A5" "boxes sealed")
(cell "Observer" "A6" "decays observed")
(cell "Observer" "A7" "sites in superposition")
(cell "Observer" "A8" "decay probability")
(cell "Observer" "A9" "seed")
(cell "Observer" "A11" "Every site is safe and decayed at once until you observe it.")
(cell "Observer" "A12" "Space observes, B boxes, C collapses, N branches to another world.")
(cell "Observer" "A13" "A decay observed is counted, and the experiment goes on.")
(formula "Observer" "B3" "=Lab!$B$2+1")
(formula "Observer" "B4" "=SUM(Tally!S1:S512)")
(formula "Observer" "B5" "=SUM(Tally!T1:T512)")
(formula "Observer" "B6" "=SUM(Tally!U1:U512)")
(formula "Observer" "B7" "=262144-B4-B5-B6")
(formula "Observer" "B8" "=Constants!$B$1")
(formula "Observer" "B9" "=Clock!$B$3")
(format 1 "6B4FC8" ";;;" nowrap)
(format 2 "FFFFFF" ";;;" nowrap)
(format 3 "F7F4FC" "\"1\"" nowrap)
(format 4 "EFE9FA" "\"2\"" nowrap)
(format 5 "E6DEF7" "\"3\"" nowrap)
(format 6 "DDD2F4" "\"4\"" nowrap)
(format 7 "D4C6F1" "\"5\"" nowrap)
(format 8 "CBBAEE" "\"6\"" nowrap)
(format 9 "C2AEEB" "\"7\"" nowrap)
(format 10 "B9A3E7" "\"8\"" nowrap)
(format 11 "A080E0" "\"▣\"" nowrap)
(format 12 "FFD5D5" "\"☢\"" nowrap)
(look "Field" 0 1)
(look "Field" 10000 2)
(look "Field" 10001 3)
(look "Field" 10002 4)
(look "Field" 10003 5)
(look "Field" 10004 6)
(look "Field" 10005 7)
(look "Field" 10006 8)
(look "Field" 10007 9)
(look "Field" 10008 10)
(look "Field" 10000000 11)
(look "Field" 10000000000 12)
(gridlines "Field" on)
(column "Observer" "A" 24 shown none)
(column "Observer" "B" 14 shown none)
(column "Constants" "A" 20 shown none)
; The engine's own sheets, as Alonzo's Cartridge::load writes them into its draft (make_own_sheets), the frame 1 and the seed 1:
