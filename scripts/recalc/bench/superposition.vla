; The recalculation floors' memory and load fixture (KERNEL.49, its first slice): Alonzo's Superposition, its
; board 512 by 512 at rate zero, 798,731 formula cells in 44 shapes, as the machine loads it. Copied from Alonzo
; at 640c0a3 (cartridges/superposition/superposition.vla, the pass's output of its .source.vla, 0BSD there and
; here), its manifest left out, and the rows of the engine's own sheets it reads written last, as Alonzo's
; Cartridge::load writes them, the seed 1. Its first frame is the cartridge's, sheet for sheet.
(sheet "Field" visible)
(sheet "Observer" visible)
(sheet "Constants" visible)
(sheet "Decays" hidden)
(sheet "Readings" hidden)
(sheet "Probe" hidden)
(sheet "First" hidden)
(sheet "FirstRow" hidden)
(sheet "Lab" hidden)
(sheet "Tally" hidden)
(sheet "Screen" hidden)
(sheet "Camera" hidden)
(sheet "Commands" hidden)
(cell "Camera" "A1" "row")
(cell "Camera" "B1" 1)
(cell "Camera" "A2" "column")
(cell "Camera" "B2" 1)
(cell "Camera" "A3" "sheet")
(cell "Camera" "B3" "Field")
(cell "Commands" "A1" "name")
(cell "Commands" "B1" "words")
(cell "Commands" "C1" "holds")
(cell "Commands" "D1" "key")
(cell "Commands" "A2" "observe")
(cell "Commands" "B2" "observe the site the selection stands on: it collapses, safe or decayed; a reading its boxes equal collapses its neighbors")
(cell "Commands" "D2" "Space")
(cell "Commands" "A3" "box")
(cell "Commands" "B3" "seal the site in a box, or open the box: a box marks a site you believe has decayed")
(cell "Commands" "D3" "KeyB")
(cell "Commands" "A4" "collapse")
(cell "Commands" "B4" "collapse a reading whose boxes equal it: every site around it is observed")
(cell "Commands" "D4" "KeyC")
(cell "Commands" "A5" "branch")
(cell "Commands" "B5" "branch to another world: a new lattice, dealt from the world's number")
(cell "Commands" "D5" "KeyN")
(cell "Constants" "A1" "decay probability")
(cell "Constants" "B1" 0.15)
(cell "Lab" "A1" "acts")
(cell "Lab" "A2" "world")
(formula "Lab" "B1" "=Lab.last!B1+IF(AND(OR(Input!$B$13=1,Input!$B$14=1,Input!$B$15=1,Input!$B$20=\"observe\",Input!$B$20=\"box\",Input!$B$20=\"collapse\"),Input!$B$19=\"Field\"),1,0)")
(formula "Lab" "B2" "=Lab.last!B2+IF(Input!$B$20=\"branch\",1,0)")
(formula "Probe" "B1:B512" "=IF(AND(OR(Input!$B$13=1,Input!$B$14=1,Input!$B$15=1,Input!$B$20=\"observe\",Input!$B$20=\"box\",Input!$B$20=\"collapse\"),Input!$B$19=\"Field\",Input!$B$12=ROW()),Input!$B$11,Probe.last!B1)")
(formula "Probe" "C1:C512" "=IF(AND(OR(Input!$B$13=1,Input!$B$14=1,Input!$B$15=1,Input!$B$20=\"observe\",Input!$B$20=\"box\",Input!$B$20=\"collapse\"),Input!$B$19=\"Field\",Input!$B$12=ROW()),IF(OR(Input!$B$14=1,Input!$B$20=\"box\"),2,IF(OR(Input!$B$15=1,Input!$B$20=\"collapse\"),3,1)),Probe.last!C1)")
(formula "Probe" "D1:D512" "=IF(AND(OR(Input!$B$13=1,Input!$B$14=1,Input!$B$15=1,Input!$B$20=\"observe\",Input!$B$20=\"box\",Input!$B$20=\"collapse\"),Input!$B$19=\"Field\",Input!$B$12=ROW()),Lab!$B$1,Probe.last!D1)")
(cell "First" "A1" "row")
(cell "First" "A2" "column")
(formula "First" "B1" "=IF(Lab!$B$2<>Lab.last!$B$2,0,IF(First.last!B1>0,First.last!B1,IF(AND(OR(Input!$B$13=1,Input!$B$20=\"observe\"),Input!$B$19=\"Field\",Input!$B$12>=1,Input!$B$12<=512,Input!$B$11>=1,Input!$B$11<=512),Input!$B$12,0)))")
(formula "First" "B2" "=IF(Lab!$B$2<>Lab.last!$B$2,0,IF(First.last!B2>0,First.last!B2,IF(AND(OR(Input!$B$13=1,Input!$B$20=\"observe\"),Input!$B$19=\"Field\",Input!$B$12>=1,Input!$B$12<=512,Input!$B$11>=1,Input!$B$11<=512),Input!$B$11,0)))")
