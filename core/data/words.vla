(slot-desc "name" "a name (one word, like total)")
(slot-desc "var" "a name (one word, like total)")
(slot-desc "text" "a reference (like B2 or \"Sheet1\")")
(slot-desc "expr" "a value (like 5, \"text\", or total plus 1)")
(slot-desc "value" "a value (like 5, revenues, or cell B2)")
(slot-desc "cond" "a condition (like total is greater than 5)")
(slot-desc "conditions" "one or more conditions joined by \", and\" (like Staff lists the person as Name, and the level is at least the min)")
(slot-desc "role" "a role noun, one word and not quoted (like person or shift)")
(slot-desc "relation" "a relation name, one word and not quoted - hyphens join its parts (like can-cover)")
(slot-desc "clause" "a rule or a fact (like a person can-cover a shift if Staff lists the person as Name, or \"Bob\" manages \"Carol\")")
(slot-desc "question" "a question (like who can-cover \"Night\", what \"Bob\" can-cover, or whether \"Bob\" can-cover \"Night\")")
(slot-desc "range" "a range (like A1:C50, B2, or Data!A1:B10 - quotes for a named range)")
