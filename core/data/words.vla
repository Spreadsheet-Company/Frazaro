(slot-desc "column" "a column letter (like C or AA)")
(slot-desc "sheet" "a sheet name (like Data)")
(slot-desc "color" "a color (like red or yellow - quotes for a code like \"#FF69B4\")")
(slot-desc "path" "a quoted path (like \"C:\\Reports\\file.xlsx\" - always quoted, a bare period would end the sentence) or a variable name")
(slot-desc "text-list" "a list of names, comma-separated (like Region, Product, and Date)")
(slot-desc "range-list" "a list of ranges, comma-separated (like A1:C50, B2, and Data!A1:B10)")
(slot-desc "cell-list" "a list of cells, comma-separated (like B2, C3, and D4)")
(slot-desc "column-list" "a list of column letters, comma-separated (like B, C, and F)")
(slot-desc "sheet-list" "a list of sheet names, comma-separated (like Data, Summary, and Notes)")
(slot-desc "color-list" "a list of colors, comma-separated (like red, green, and blue)")
